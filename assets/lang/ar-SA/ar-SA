	<sys:String x:Key="K0796"  xml:space="preserve">هل أنت متأكد من عدم تعيين كلمة مرور؟</sys:String>
	<sys:String x:Key="K0797"  xml:space="preserve">السماح لمساعدة الجهاز بإجراء مكالمات هاتفية وإدارتها؟</sys:String>
