	<sys:String x:Key="K1062"  xml:space="preserve">मोबाइल हॉटस्पॉट कैसे चालू करें</sys:String>
	<sys:String x:Key="K1063"  xml:space="preserve">सबसे पहले अपने डिवाइस पर हॉटस्पॉट चालू करें।</sys:String>
	<sys:String x:Key="K1064"  xml:space="preserve">फिर, हॉटस्पॉट नाम और पासवर्ड कॉन्फ़िगर करें।</sys:String>
	<sys:String x:Key="K1065"  xml:space="preserve">अंत में, इस हॉटस्पॉट को अपने पीसी से कनेक्ट करें।</sys:String>
	<sys:String x:Key="K1066"  xml:space="preserve">यूएसबी डिबगिंग कैसे चालू करें</sys:String>
	<sys:String x:Key="K1067"  xml:space="preserve">यदि आप कनेक्ट करने के लिए QR कोड को स्कैन नहीं करना चाहते हैं, तो आप सीधे MA में IP दर्ज कर सकते हैं। आपका IP पता है</sys:String>
	<sys:String x:Key="K1068"  xml:space="preserve">मोबाइल हॉटस्पॉट कैसे चालू करें?</sys:String>
	<sys:String x:Key="K1069"  xml:space="preserve">नये डिवाइस कनेक्शन का पता चला, मिलान वाले फर्मवेयर की प्रतीक्षा कर रहा है...</sys:String>
	<sys:String x:Key="K1070"  xml:space="preserve">आप जिस डिवाइस से जुड़े हैं उसका मॉडल नाम दर्ज किए गए IMEI से मेल नहीं खाता। आपका डिवाइस {0} है। क्या आप रेस्क्यू के लिए फ़र्मवेयर को फिर से मिलाने के लिए कनेक्टेड डिवाइस का उपयोग करना चाहते हैं?</sys:String>
	<sys:String x:Key="K1071"  xml:space="preserve">स्क्रीन मिरर के लिए ज़रूरी है कि आपका डिवाइस और पीसी एक ही नेटवर्क सेगमेंट में हों। कृपया अपने डिवाइस को पीसी के साथ एक ही वाई-फाई से कनेक्ट करने के बाद फिर से प्रयास करें।</sys:String>
	<sys:String x:Key="K1072"  xml:space="preserve">आप पहुँच सकते हैं</sys:String>
	<sys:String x:Key="K1073"  xml:space="preserve">ऑनलाइन मंच</sys:String>
	<sys:String x:Key="K1074"  xml:space="preserve">और अन्य उपयोगकर्ताओं से पूछें कि क्या उन्हें भी ऐसी ही समस्या आती है।</sys:String>
	<sys:String x:Key="K1075"  xml:space="preserve">आपका पिछला ऑपरेशन गलत था और डिवाइस कनेक्ट नहीं था। आप फिर से काम करने के लिए नीचे दिए गए चरणों का पालन कर सकते हैं:&#x0a;&#x0a;1. डिवाइस को बंद करें।&#x0a;&#x0a;2. डिवाइस को चालू करें।&#x0a;&#x0a;3. सुनिश्चित करें कि आपका डिवाइस बंद है और पीसी से कनेक्ट नहीं है।&#x0a;&#x0a;4. वॉल्यूम &quot;+&quot; बटन दबाएँ और उसी समय USB के माध्यम से डिवाइस को पीसी से कनेक्ट करें।&#x0a;&#x0a;5. प्रगति शुरू होने के बाद वॉल्यूम कुंजी छोड़ दें।</sys:String>
	<sys:String x:Key="K1076"  xml:space="preserve">आपकी यूएसबी केबल को अनप्लग किया जा सकता है।</sys:String>
	<sys:String x:Key="K1077"  xml:space="preserve">सॉफ़्टवेयर फ़िक्स ने पता लगाया है कि आपका डिवाइस डिवाइस सहायता के माध्यम से कनेक्ट हुआ है, कृपया जारी रखने के लिए डिस्कनेक्ट करें।</sys:String>
	<sys:String x:Key="K1078"  xml:space="preserve">Android 10 या उच्चतर</sys:String>
	<sys:String x:Key="K1079"  xml:space="preserve">का चयन करें</sys:String>
	<sys:String x:Key="K1080"  xml:space="preserve">एंड्रॉयड संस्करण</sys:String>
	<sys:String x:Key="K1081"  xml:space="preserve">अपने डिवाइस का चयन करें और ट्यूटोरियल चरणों का पालन करें:</sys:String>
	<sys:String x:Key="K1082"  xml:space="preserve">Android संस्करण कैसे खोजें</sys:String>
	<sys:String x:Key="K1083"  xml:space="preserve">अपने फोन पर, 'सेटिंग्स' -> 'फोन के बारे में' स्क्रीन खोलें।</sys:String>
	<sys:String x:Key="K1084"  xml:space="preserve">चरण 1: अपने फ़ोन पर, 'सेटिंग्स' -> 'फ़ोन के बारे में' स्क्रीन खोलें। इसे खोलने के बाद नीचे 'अगला' बटन चुनें।</sys:String>
	<sys:String x:Key="K1085"  xml:space="preserve">अपने फ़ोन पर, 'सेटिंग्स'->'सिस्टम'->'फ़ोन के बारे में' स्क्रीन खोलें.&#x0a;(*एंड्रॉइड 8.0 से)</sys:String>
	<sys:String x:Key="K1086"  xml:space="preserve">अपने टैबलेट पर, 'सेटिंग्स'->'सिस्टम'->'टैबलेट के बारे में' स्क्रीन खोलें.&#x0a;(*एंड्रॉइड 8.0 से)</sys:String>
	<sys:String x:Key="K1087"  xml:space="preserve">अपने टैबलेट पर, 'सेटिंग्स' -> 'सिस्टम'* -> 'टैबलेट के बारे में' स्क्रीन खोलें।(*एंड्रॉइड 8.0 से)</sys:String>
	<sys:String x:Key="K1088"  xml:space="preserve">(सेटिंग्स->सिस्टम->टैबलेट के बारे में->बिल्ड नंबर)&#x0a;आपके टैबलेट का वर्तमान बिल्ड संस्करण प्रारूप जैसे:</sys:String>
	<sys:String x:Key="K1089"  xml:space="preserve">आपके टैबलेट का वर्तमान बिल्ड संस्करण प्रारूप इस प्रकार है:</sys:String>
	<sys:String x:Key="K1090"  xml:space="preserve">अन्य असाधारण</sys:String>
	<sys:String x:Key="K1091"  xml:space="preserve">Android 7.0 या पहले का संस्करण</sys:String>
	<sys:String x:Key="K1092"  xml:space="preserve">कृपया अपना डिवाइस बंद करें और फिर चालू करें और फिर से प्रयास करें। यदि यह अभी भी काम नहीं करता है, तो सॉफ़्टवेयर फ़िक्स अनुशंसा करता है कि आप सहायता के लिए ग्राहक केंद्र पर जाएँ।</sys:String>
	<sys:String x:Key="K1093"  xml:space="preserve">मॉडल का नाम गायब है</sys:String>
	<sys:String x:Key="K1094"  xml:space="preserve">सॉफ़्टवेयर फ़िक्स आपके पीसी पर डिवाइस बचाव फ़ंक्शन का उपयोग करने के लिए कुछ डिवाइस ड्राइवर स्थापित करेगा। कृपया जारी रखने के लिए चरणों का पालन करें।</sys:String>
	<sys:String x:Key="K1095"  xml:space="preserve">हटाना समाप्त, {0} सफल, {1} विफल.</sys:String>
	<sys:String x:Key="K1096"  xml:space="preserve">{0} को आपकी अनुमति चाहिए। कृपया फ़ोन पर इसकी अनुमति दें और 'जारी रखें' पर क्लिक करें।</sys:String>
	<sys:String x:Key="K1097"  xml:space="preserve">1. 'सेटिंग्स' पर जाएं, शीर्ष खोज बॉक्स में, 'बिल्ड' टाइप करें, खोज परिणाम सूची में 'बिल्ड नंबर' चुनें।</sys:String>
	<sys:String x:Key="K1098"  xml:space="preserve">2. 'बिल्ड नंबर' पर 7 बार टैप करें।</sys:String>
	<sys:String x:Key="K1099"  xml:space="preserve">3. &quot;सेटिंग्स&quot; से बाहर निकलें, फिर इसे दोबारा खोलें। ऊपर दिए गए खोज बॉक्स में &quot;USB&quot; टाइप करें, खोज परिणामों में से &quot;USB डिबगिंग&quot; चुनें, और अगले पृष्ठ पर &quot;डेवलपर विकल्प&quot; तथा &quot;USB डिबगिंग&quot; को सक्षम करें।</sys:String>
	<sys:String x:Key="K1100"  xml:space="preserve">1. 'सेटिंग्स' पर जाएं, शीर्ष खोज बॉक्स में, 'अबाउट' टाइप करें, खोज परिणाम सूची में 'अबाउट फोन' का चयन करें।</sys:String>
	<sys:String x:Key="K1101"  xml:space="preserve">2. 'लीजन ओएस' ढूंढें और 7 बार टैप करें।</sys:String>
	<sys:String x:Key="K1102"  xml:space="preserve">1. 'सेटिंग्स' पर जाएं, शीर्ष खोज बॉक्स में, 'अबाउट' टाइप करें, खोज परिणाम सूची में 'अबाउट टैबलेट' का चयन करें।</sys:String>
	<sys:String x:Key="K1103"  xml:space="preserve">2. &quot;बिल्ड नंबर&quot; या &quot;सॉफ्टवेयर वर्जन&quot; को ढूंढें और 7 बार टैप करें।</sys:String>
	<sys:String x:Key="K1104"  xml:space="preserve">इस बात की बहुत कम संभावना है कि आपको इस पेज पर 'बिल्ड नंबर' न मिले। 'एंड्रॉइड वर्जन' पर टैप करें, आपको अगले पेज पर 'बिल्ड नंबर' मिलेगा।</sys:String>
	<sys:String x:Key="K1105"  xml:space="preserve">कृपया डिवाइस सिस्टम की संगत भाषा में खोजें।</sys:String>
	<sys:String x:Key="K1106"  xml:space="preserve">चीन में बिकने वाले टैबलेट को फिलहाल सपोर्ट नहीं किया जाता है। इन डिवाइस को जबरन हटाना जोखिम भरा होगा।</sys:String>
	<sys:String x:Key="K1107"  xml:space="preserve"> 3. 'सेटिंग्स' पर जाएँ, सबसे ऊपर सर्च बॉक्स में 'USB' टाइप करें, सर्च रिजल्ट लिस्ट में 'USB डीबगिंग' चुनें। अगले पेज पर 'डेवलपर विकल्प' और 'USB डीबगिंग' को सक्षम करें।</sys:String>
	<sys:String x:Key="K1108"  xml:space="preserve"> 3. 'सेटिंग्स' पर जाएँ, सबसे ऊपर सर्च बॉक्स में 'USB' टाइप करें, सर्च रिजल्ट लिस्ट में 'USB डीबगिंग' चुनें। अगले पेज पर 'डेवलपर विकल्प' और 'USB डीबगिंग' को सक्षम करें।</sys:String>
	<sys:String x:Key="K1109"  xml:space="preserve">चित्र और वीडियो अधिकृत करें</sys:String>
