	<sys:String x:Key="K1051"  xml:space="preserve">मोबाइल असिस्टेंट ऐप कैसे इंस्टॉल करें</sys:String>
	<sys:String x:Key="K1052"  xml:space="preserve">विधि १</sys:String>
	<sys:String x:Key="K1053"  xml:space="preserve">विधि 2</sys:String>
	<sys:String x:Key="K1054"  xml:space="preserve">1. अपने डिवाइस पर मोबाइल असिस्टेंट ऐप डाउनलोड करें</sys:String>
