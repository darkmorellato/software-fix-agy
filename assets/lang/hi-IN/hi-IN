	<sys:String x:Key="K1428"  xml:space="preserve">ऊंचाई</sys:String>
	<sys:String x:Key="K1429"  xml:space="preserve">विवरण</sys:String>
	<sys:String x:Key="K1430"  xml:space="preserve">सॉफ़्टवेयर फ़िक्स मिलान फ़र्मवेयर का चयन करें</sys:String>
	<sys:String x:Key="K1431"  xml:space="preserve">डिवाइस जानकारी</sys:String>
	<sys:String x:Key="K1432"  xml:space="preserve">जब आप अपने डिवाइस पर रिकॉर्डिंग समाप्त कर लें, तो यहां रिकॉर्डिंग फ़ाइल देखने के लिए रिफ्रेश बटन का चयन करें।</sys:String>
