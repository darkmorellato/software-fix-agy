	<sys:String x:Key="K0686"  xml:space="preserve">फ़ोन जोड़ें</sys:String>
	<sys:String x:Key="K0687"  xml:space="preserve">यूएसबी कनेक्टेड</sys:String>
	<sys:String x:Key="K0688"  xml:space="preserve">फ़ोन</sys:String>
	<sys:String x:Key="K0689"  xml:space="preserve">व्यक्तिगत डेटा हटाएं</sys:String>
	<sys:String x:Key="K0690"  xml:space="preserve">व्यक्तिगत डेटा फ़ाइलें</sys:String>
	<sys:String x:Key="K0691"  xml:space="preserve">व्यक्तिगत डेटा वाली फ़ाइलों को हटाया नहीं जा सकता। नीचे सूचीबद्ध फ़ोल्डर की समीक्षा करें और अपना व्यक्तिगत डेटा हटाने का प्रयास करें।</sys:String>
	<sys:String x:Key="K0692"  xml:space="preserve">कोई भी ऐसा संसाधन नहीं मिला जिसे हटाया जा सके</sys:String>
	<sys:String x:Key="K0693"  xml:space="preserve">हटाया जा रहा है...</sys:String>
	<sys:String x:Key="K0694"  xml:space="preserve">रुकना</sys:String>
	<sys:String x:Key="K0695"  xml:space="preserve">कोई व्यक्तिगत डेटा नहीं मिला.</sys:String>
	<sys:String x:Key="K0696"  xml:space="preserve">व्यक्तिगत डेटा फ़ाइलें मिलीं; जैसे निर्यातित चित्र, वीडियो, ऑडियो, एसएमएस, संपर्क, डिवाइस बैकअप फ़ाइलें और अन्य अस्थायी फ़ाइलें.&#x0a;&#x0a;हटाएँ?</sys:String>
	<sys:String x:Key="K0697"  xml:space="preserve">स्कैनिंग...</sys:String>
	<sys:String x:Key="K0698"  xml:space="preserve">समझ गया</sys:String>
	<sys:String x:Key="K0699"  xml:space="preserve">इंतज़ार में</sys:String>
	<sys:String x:Key="K0700"  xml:space="preserve">मिटाना?</sys:String>
	<sys:String x:Key="K0701"  xml:space="preserve">हटाना विफल</sys:String>
	<sys:String x:Key="K0702"  xml:space="preserve">बचाव कार्य पूरा करने में असफल!</sys:String>
	<sys:String x:Key="K0703"  xml:space="preserve">स्क्रीन रिकॉर्डिंग निर्यात की जा रही है...</sys:String>
	<sys:String x:Key="K0704"  xml:space="preserve">अपने व्यक्तिगत डेटा का उपयोग करने के बाद उसे हटाना याद रखें।</sys:String>
	<sys:String x:Key="K0705"  xml:space="preserve">पंजीकृत डिवाइस</sys:String>
	<sys:String x:Key="K0706"  xml:space="preserve">कोई डिवाइस पंजीकृत नहीं है</sys:String>
	<sys:String x:Key="K0707"  xml:space="preserve">नया डिवाइस कनेक्ट हुआ। क्या आप इसे अपने खाते से पंजीकृत करना चाहेंगे?</sys:String>
	<sys:String x:Key="K0708"  xml:space="preserve">इस डिवाइस का पंजीकरण रद्द करें?</sys:String>
	<sys:String x:Key="K0709"  xml:space="preserve">स्थापना विफल</sys:String>
	<sys:String x:Key="K0710"  xml:space="preserve">यदि मोबाइल असिस्टेंट ऐप को सॉफ्टवेयर फिक्स द्वारा डिवाइस में इंस्टॉल किया गया था</sys:String>
	<sys:String x:Key="K0711"  xml:space="preserve">जानकारी</sys:String>
	<sys:String x:Key="K0712"  xml:space="preserve">क्या आप आश्वस्त है कि आपको डिलीट करना है?</sys:String>
	<sys:String x:Key="K0713"  xml:space="preserve">पीसी में पर्याप्त खाली स्थान नहीं है। कुछ खाली करें, फिर पुनः प्रयास करें।</sys:String>
	<sys:String x:Key="K0714"  xml:space="preserve">मेल खाते फर्मवेयर की प्रतीक्षा करें</sys:String>
	<sys:String x:Key="K0715"  xml:space="preserve">स्थानांतरित कर रहा है</sys:String>
	<sys:String x:Key="K0716"  xml:space="preserve">सॉफ़्टवेयर सुधार के लिए प्रतिक्रिया</sys:String>
	<sys:String x:Key="K0717"  xml:space="preserve">नाम:</sys:String>
	<sys:String x:Key="K0718"  xml:space="preserve">कृपया अपना नाम दर्ज करें</sys:String>
	<sys:String x:Key="K0719"  xml:space="preserve">ईमेल:</sys:String>
	<sys:String x:Key="K0720"  xml:space="preserve">टिप्पणियाँ:</sys:String>
	<sys:String x:Key="K0721"  xml:space="preserve">कृपया अपना ईमेल पता साझा करें</sys:String>
	<sys:String x:Key="K0722"  xml:space="preserve">सॉफ़्टवेयर फ़िक्स का उपयोग करते समय आप जो भी पूछना चाहते हैं, उसे हमारे साथ साझा करें, जैसे कि प्रश्न, समस्या या सलाह</sys:String>
	<sys:String x:Key="K0723"  xml:space="preserve">प्रोडक्ट का नाम:</sys:String>
	<sys:String x:Key="K0724"  xml:space="preserve">कृपया उत्पाद का नाम दर्ज करें</sys:String>
	<sys:String x:Key="K0725"  xml:space="preserve">कृपया मॉडल का नाम दर्ज करें</sys:String>
	<sys:String x:Key="K0726"  xml:space="preserve">डिवाइस जानकारी संलग्न करें</sys:String>
	<sys:String x:Key="K0727"  xml:space="preserve">यदि आपकी प्रतिक्रिया निम्नलिखित डिवाइस जानकारी से संबंधित नहीं है, तो उसे अनचेक करें.</sys:String>
	<sys:String x:Key="K0728"  xml:space="preserve">लॉग अपलोड करें</sys:String>
	<sys:String x:Key="K0729"  xml:space="preserve">विश्लेषण के लिए एप्लिकेशन लॉग अपलोड करने के लिए इस विकल्प पर टिक करें</sys:String>
	<sys:String x:Key="K0730"  xml:space="preserve">आपकी प्रतिक्रिया का जवाब</sys:String>
	<sys:String x:Key="K0731"  xml:space="preserve">आपकी प्रतिक्रिया (जारी)</sys:String>
	<sys:String x:Key="K0732"  xml:space="preserve">आपकी प्रतिक्रिया</sys:String>
	<sys:String x:Key="K0733"  xml:space="preserve">फीडबैक सफलतापूर्वक प्रस्तुत किया गया.</sys:String>
	<sys:String x:Key="K0734"  xml:space="preserve">प्रतिक्रिया सबमिट करने में विफल.</sys:String>
	<sys:String x:Key="K0735"  xml:space="preserve">1. यह फर्मवेयर केवल भारत के कस्टमाइज्ड वर्जन टैबलेट के लिए है, अगर आपका डिवाइस भारत का जनरल वर्जन है, तो कृपया लेनोवो TB-7304F चुनें। जनरल वर्जन और कस्टमाइज्ड वर्जन को मिक्स नहीं किया जा सकता।&#x0a;2. डिवाइस को बंद करें, इसे पीसी से डिस्कनेक्ट करें, फिर जारी रखने के लिए ओके पर क्लिक करें।</sys:String>
	<sys:String x:Key="K0736"  xml:space="preserve">आपका डिवाइस संस्करण नवीनतम संस्करण है, क्या आप फिर से बचाव करना चाहते हैं?</sys:String>
	<sys:String x:Key="K0737"  xml:space="preserve">3. यदि आवश्यक अनुमतियों में से एक को अस्वीकार कर दिया जाता है, तो मोबाइल सहायक ऐप सही तरीके से काम नहीं करेगा। आप एंड्रॉइड सिस्टम सेटिंग्स में ऐप अनुमतियों पर जा सकते हैं, और इसे फिर से अधिकृत कर सकते हैं।</sys:String>
	<sys:String x:Key="K0738"  xml:space="preserve">कनेक्ट हो रहा है, यदि कोई प्रगति नहीं होती है तो अपने डिवाइस की स्क्रीन अनलॉक करें</sys:String>
	<sys:String x:Key="K0739"  xml:space="preserve">USB डीबगिंग को अधिकृत करने के लिए अपने डिवाइस पर इस विकल्प को चेक करें।</sys:String>
	<sys:String x:Key="K0740"  xml:space="preserve">कंप्यूटर का सॉफ्टवेयर फिक्स कुंजी फिंगरप्रिंट है:</sys:String>
	<sys:String x:Key="K0741"  xml:space="preserve">मोबाइल कनेक्शन पहचाना नहीं जा सका.</sys:String>
	<sys:String x:Key="K0742"  xml:space="preserve">अपने डिवाइस को डिस्कनेक्ट करें, फिर उसे पुनः कनेक्ट करें।</sys:String>
	<sys:String x:Key="K0743"  xml:space="preserve">अस्वीकार करना</sys:String>
	<sys:String x:Key="K0744"  xml:space="preserve">अनुमति दें</sys:String>
	<sys:String x:Key="K0745"  xml:space="preserve">1. डिवाइस पर, &quot;सिस्टम सेटिंग संशोधित करने की अनुमति दें&quot; चालू करें, फिर मोबाइल सहायक ऐप पर वापस जाएं।</sys:String>
	<sys:String x:Key="K0746"  xml:space="preserve">मोबाइल सहायक</sys:String>
	<sys:String x:Key="K0747"  xml:space="preserve">सिस्टम सेटिंग संशोधित करने की अनुमति दें</sys:String>
	<sys:String x:Key="K0748"  xml:space="preserve">यह अनुमति किसी ऐप को सिस्टम सेटिंग संशोधित करने की अनुमति देती है.</sys:String>
	<sys:String x:Key="K0749"  xml:space="preserve">2. मोबाइल सहायक ऐप में, अनुरोधित अनुमतियों की अनुमति दें।</sys:String>
	<sys:String x:Key="K0750"  xml:space="preserve">मोबाइल सहायक को फ़ोन कॉल करने और प्रबंधित करने की अनुमति दें?</sys:String>
	<sys:String x:Key="K0751"  xml:space="preserve">6 में से 1</sys:String>
	<sys:String x:Key="K0752"  xml:space="preserve">क्या आप मूल बैकअप फ़ाइल को अधिलेखित करना चाहते हैं?&#x0a;यदि आप इसे रखना चाहते हैं, तो 'नहीं' बटन पर क्लिक करें, और एक नई फ़ाइल बनाएं।</sys:String>
	<sys:String x:Key="K0753"  xml:space="preserve">कनेक्ट करना विफल</sys:String>
	<sys:String x:Key="K0754"  xml:space="preserve">अमान्य उपयोगकर्ता नाम या पासवर्ड।</sys:String>
	<sys:String x:Key="K0755"  xml:space="preserve">वापस जाओ</sys:String>
	<sys:String x:Key="K0756"  xml:space="preserve">कंप्यूटर</sys:String>
	<sys:String x:Key="K0757"  xml:space="preserve">उपकरण</sys:String>
	<sys:String x:Key="K0758"  xml:space="preserve">सहायक ऐप संस्करण की जाँच करना</sys:String>
	<sys:String x:Key="K0759"  xml:space="preserve">सहायक ऐप इंस्टॉल करना</sys:String>
	<sys:String x:Key="K0760"  xml:space="preserve">सहायक ऐप इंस्टॉल करना सफल हुआ</sys:String>
	<sys:String x:Key="K0761"  xml:space="preserve">कनेक्ट करना सफल हुआ</sys:String>
	<sys:String x:Key="K0762"  xml:space="preserve">डिवाइस डेटा लोड करना सफल रहा</sys:String>
	<sys:String x:Key="K0763"  xml:space="preserve">रिंगटोन सेट करने में सफल रहे.</sys:String>
	<sys:String x:Key="K0764"  xml:space="preserve">सबका चयन करें</sys:String>
	<sys:String x:Key="K0765"  xml:space="preserve">Assistant ऐप का वर्शन मेल नहीं खाता</sys:String>
	<sys:String x:Key="K0766"  xml:space="preserve">Assistant ऐप वर्शन का मिलान किया गया</sys:String>
	<sys:String x:Key="K0767"  xml:space="preserve">मिलते-जुलते फर्मवेयर का इंतज़ार करें, अपने डिवाइस को अनप्लग न करें</sys:String>
	<sys:String x:Key="K0768"  xml:space="preserve">कनेक्ट करना विफल हुआ, कृपया अपना डिवाइस पुनः कनेक्ट करें और पुनः प्रयास करें.</sys:String>
	<sys:String x:Key="K0769"  xml:space="preserve">कृपया अपने डिवाइस पर यह अनुमति चालू करें.</sys:String>
	<sys:String x:Key="K0770"  xml:space="preserve">कार्रवाई आवश्यक है</sys:String>
	<sys:String x:Key="K0771"  xml:space="preserve">पहले का</sys:String>
	<sys:String x:Key="K0772"  xml:space="preserve">ट्यूटोरियल</sys:String>
	<sys:String x:Key="K0773"  xml:space="preserve">कॉल रिंगटोन की ध्वनि 40 सेकंड से कम रखने की अनुशंसा की जाती है।</sys:String>
	<sys:String x:Key="K0774"  xml:space="preserve">अधिसूचना रिंगटोन की अवधि 20 सेकंड से कम रखने की अनुशंसा की जाती है।</sys:String>
	<sys:String x:Key="K0775"  xml:space="preserve">सहायक ऐप अनइंस्टॉल करना</sys:String>
	<sys:String x:Key="K0776"  xml:space="preserve">Assistant ऐप अनइंस्टॉल करना सफल रहा</sys:String>
	<sys:String x:Key="K0777"  xml:space="preserve">फ्लैशिंग चालू रहने के दौरान बाहर नहीं निकला जा सकता।</sys:String>
	<sys:String x:Key="K0778"  xml:space="preserve">बैकअप एन्क्रिप्ट करें</sys:String>
	<sys:String x:Key="K0779"  xml:space="preserve">सांकेतिक शब्द लगना</sys:String>
	<sys:String x:Key="K0780"  xml:space="preserve">अपने बैकअप की सुरक्षा के लिए पासवर्ड दर्ज करें.</sys:String>
	<sys:String x:Key="K0781"  xml:space="preserve">कृपया ध्यान रखें कि यदि पासवर्ड भूल गए तो बैकअप को अनलॉक नहीं किया जा सकेगा।</sys:String>
	<sys:String x:Key="K0782"  xml:space="preserve">पासवर्ड को सत्यापित करें</sys:String>
	<sys:String x:Key="K0783"  xml:space="preserve">4 अक्षरों से कम. बहुत छोटा.</sys:String>
	<sys:String x:Key="K0784"  xml:space="preserve">पीसी में पर्याप्त खाली स्थान नहीं है। कुछ खाली करें, फिर पुनः प्रयास करें।</sys:String>
	<sys:String x:Key="K0785"  xml:space="preserve">पास वर्ड दर्ज करें</sys:String>
	<sys:String x:Key="K0786"  xml:space="preserve">अपना बैकअप अनलॉक करने के लिए पासवर्ड दर्ज करें</sys:String>
	<sys:String x:Key="K0787"  xml:space="preserve">प्रसंस्करण</sys:String>
	<sys:String x:Key="K0788"  xml:space="preserve">पासवर्ड ग़लत है.</sys:String>
	<sys:String x:Key="K0789"  xml:space="preserve">कनेक्ट करते समय, कृपया अपने डिवाइस पर जाएँ और डिवाइस हेल्प ऐप के 'अनुमति आवश्यक' प्रॉम्प्ट को अनुमति दें। या यदि यह पहली बार है, तो कृपया मोटोरोला गोपनीयता नीति से सहमत हों, और फिर डिवाइस को फिर से कनेक्ट करें।</sys:String>
	<sys:String x:Key="K0790"  xml:space="preserve">कृपया डिवाइस स्क्रीन पर उपयोगकर्ता सहमति संकेत की जांच करें, और बैकअप शुरू करने के लिए उसे अनुमति दें।</sys:String>
	<sys:String x:Key="K0791"  xml:space="preserve">बैकअप शुरू नहीं होगा क्योंकि आपने उपयोगकर्ता सहमति प्रॉम्प्ट पर इनकार कर दिया है। उपयोगकर्ता सहमति प्रॉम्प्ट की अनुमति देने के बाद आप नया बैकअप शुरू कर सकते हैं।</sys:String>
	<sys:String x:Key="K0792"  xml:space="preserve">कनेक्ट करना विफल रहा, कृपया डिवाइस को पुनः कनेक्ट करें, और यदि डिवाइस पर डिवाइस सहायता ऐप का ऐसा कोई संकेत हो तो मोटोरोला गोपनीयता नीति से सहमत होना न भूलें।</sys:String>
	<sys:String x:Key="K0793"  xml:space="preserve">सुनिश्चित करें कि लक्ष्य फ़र्मवेयर आपके डिवाइस मॉडल से मेल खाता है। फ्लैशिंग डिवाइस से सभी डेटा हटा देता है।</sys:String>
	<sys:String x:Key="K0794"  xml:space="preserve">USB के माध्यम से कनेक्ट करने से पहले USB डीबगिंग सक्षम करें।</sys:String>
	<sys:String x:Key="K0795"  xml:space="preserve">दाखिल करना...</sys:String>
	<sys:String x:Key="K0796"  xml:space="preserve">क्या आप निश्चित हैं कि आपको पासवर्ड सेट नहीं करना है?</sys:String>
	<sys:String x:Key="K0797"  xml:space="preserve">डिवाइस सहायता को फ़ोन कॉल करने और प्रबंधित करने की अनुमति दें?</sys:String>
