	<sys:String x:Key="K1409"  xml:space="preserve">नहीं मिला</sys:String>
	<sys:String x:Key="K1410"  xml:space="preserve">वाईफ़ाई</sys:String>
	<sys:String x:Key="K1411"  xml:space="preserve">2. यदि आपके डिवाइस में डिवाइस हेल्प ऐप इंस्टॉल है, तो कनेक्ट करने के लिए निम्नलिखित QR कोड को स्कैन करने के लिए इसका उपयोग करें।</sys:String>
	<sys:String x:Key="K1412"  xml:space="preserve">3. यदि कोई डिवाइस सहायता ऐप इंस्टॉल नहीं है, तो मोबाइल सहायक ऐप डाउनलोड करें और इंस्टॉल करें</sys:String>
	<sys:String x:Key="K1413"  xml:space="preserve">कृपया सामग्री इनपुट करें</sys:String>
