	<sys:String x:Key="K0915"  xml:space="preserve">चरण 3. अपने डिवाइस पर वॉल्यूम डाउन कुंजी दबाकर रखें और यूएसबी केबल को अपने डिवाइस से कनेक्ट करें।</sys:String>
	<sys:String x:Key="K0916"  xml:space="preserve">चरण 4. जब फोन के डिस्प्ले पर हरा एंड्रॉयड दिखाई दे तो अपने डिवाइस पर वॉल्यूम डाउन कुंजी छोड़ दें।</sys:String>
	<sys:String x:Key="K0917"  xml:space="preserve">ऐसे उपकरण के लिए जो पावर चालू नहीं कर सकता:</sys:String>
	<sys:String x:Key="K0918"  xml:space="preserve">सिम कार्ड स्लॉट को बाहर निकालें, उस पर IMEI ढूंढें</sys:String>
	<sys:String x:Key="K0919"  xml:space="preserve">डायलर कीबोर्ड *#06#</sys:String>
	<sys:String x:Key="K0920"  xml:space="preserve">जाओ</sys:String>
	<sys:String x:Key="K0921"  xml:space="preserve">यदि आप फर्मवेयर प्राप्त करने के लिए मैन्युअल रूप से चयन करना चाहते हैं तो यहां क्लिक करें:</sys:String>
	<sys:String x:Key="K0922"  xml:space="preserve">फास्टबूट चयन</sys:String>
	<sys:String x:Key="K0923"  xml:space="preserve">मैनुअल चयन</sys:String>
	<sys:String x:Key="K0924"  xml:space="preserve">डिवाइस पैकेजिंग बॉक्स</sys:String>
	<sys:String x:Key="K0925"  xml:space="preserve">तरीका</sys:String>
	<sys:String x:Key="K0926"  xml:space="preserve">कृपया अपने फ़ोन का 15-अंकीय IMEI दर्ज करें, और हम मिलान करने वाला फ़र्मवेयर खोजने के लिए फ़ोन मॉडल की जाँच करेंगे:</sys:String>
	<sys:String x:Key="K0927"  xml:space="preserve">IMEI कैसे पता करें?</sys:String>
	<sys:String x:Key="K0928"  xml:space="preserve">फ़ोन बचाव</sys:String>
	<sys:String x:Key="K0929"  xml:space="preserve">टैबलेट</sys:String>
	<sys:String x:Key="K0930"  xml:space="preserve">टैबलेट बचाव</sys:String>
	<sys:String x:Key="K0931"  xml:space="preserve">प्रोडक्ट का नाम</sys:String>
	<sys:String x:Key="K0932"  xml:space="preserve">अधिक</sys:String>
	<sys:String x:Key="K0933"  xml:space="preserve">उपयुक्त फर्मवेयर से मेल नहीं खाता.</sys:String>
	<sys:String x:Key="K0934"  xml:space="preserve">आप स्वयं मैन्युअल रूप से फर्मवेयर का चयन करने का प्रयास कर सकते हैं।</sys:String>
	<sys:String x:Key="K0935"  xml:space="preserve">कुछ महत्वपूर्ण जानकारी डिवाइस से नहीं पढ़ी जा सकती, कृपया अपने डिवाइस को फास्टबूट मोड से डिस्कनेक्ट और पुनः कनेक्ट करें।</sys:String>
	<sys:String x:Key="K0936"  xml:space="preserve">आपका IMEI {0} है</sys:String>
	<sys:String x:Key="K0937"  xml:space="preserve">उपयुक्त फर्मवेयर से मेल नहीं खाता, कृपया सहायता वेबसाइट से सहायता लें: support.motorola.com</sys:String>
	<sys:String x:Key="K0938"  xml:space="preserve">कृपया अपना IMEI दर्ज करें...</sys:String>
	<sys:String x:Key="K0939"  xml:space="preserve">सूचना संकलन</sys:String>
	<sys:String x:Key="K0940"  xml:space="preserve">वैध बिक्री-पश्चात सेवा को बनाए रखने के लिए, इस समय आपकी जानकारी एकत्र की जाएगी। यदि आप जारी रखना चाहते हैं तो आगे बढ़ें बटन का चयन करें।</sys:String>
	<sys:String x:Key="K0941"  xml:space="preserve">बूट होने में कई मिनट लगेंगे, कृपया प्रतीक्षा करें।</sys:String>
	<sys:String x:Key="K0942"  xml:space="preserve">कृपया सभी एंड्रॉयड डिवाइसों को डिस्कनेक्ट करें और सुनिश्चित करें कि कोई भी डिवाइस कनेक्ट नहीं है, फिर रेस्क्यू का पुनः प्रयास करें।</sys:String>
	<sys:String x:Key="K0943"  xml:space="preserve">उपयुक्त फर्मवेयर से मेल नहीं खाता.&#x0a;आप डिवाइस को USB डीबगिंग मोड में कनेक्ट करने का प्रयास कर सकते हैं.&#x0a;यदि तब भी कोई मेल नहीं खाता, तो यह डिवाइस समर्थित नहीं है.</sys:String>
	<sys:String x:Key="K0944"  xml:space="preserve">ऐसे उपकरण के लिए जो पावर चालू नहीं कर सकता:</sys:String>
	<sys:String x:Key="K0945"  xml:space="preserve">एंड्रॉइड 8.0 या उच्चतर</sys:String>
	<sys:String x:Key="K0946"  xml:space="preserve">फ़ोन के बारे में</sys:String>
	<sys:String x:Key="K0947"  xml:space="preserve">हमने देखा कि रेस्क्यू फ्लैशिंग कई बार सफलतापूर्वक की गई है।</sys:String>
	<sys:String x:Key="K0948"  xml:space="preserve">क्या रेस्क्यू फ्लैश ने आपकी समस्या हल कर दी?</sys:String>
	<sys:String x:Key="K0949"  xml:space="preserve">यदि नहीं, तो क्या आप कृपया आगे के विश्लेषण के लिए निम्नलिखित जानकारी हमारे साथ साझा करेंगे?</sys:String>
	<sys:String x:Key="K0950"  xml:space="preserve">रेस्क्यू फ्लैशिंग से पहले अपने डिवाइस की समस्या और स्थिति का वर्णन करें:</sys:String>
	<sys:String x:Key="K0951"  xml:space="preserve">रेस्क्यू फ्लैशिंग के बाद अपने डिवाइस की स्थिति का वर्णन करें:</sys:String>
	<sys:String x:Key="K0952"  xml:space="preserve">कृपया पुष्टि करें कि निम्नलिखित जानकारी आपके डिवाइस से मेल खाती है:&#x0a;&#x0a;उत्पाद का नाम: {0}&#x0a;&#x0a;मॉडल का नाम: {1}</sys:String>
	<sys:String x:Key="K0953"  xml:space="preserve">कृपया पुष्टि करें कि निम्नलिखित जानकारी आपके डिवाइस से मेल खाती है: मॉडल का नाम: {0} मॉडल संख्या: {1}</sys:String>
	<sys:String x:Key="K0954"  xml:space="preserve">अपने डिवाइस प्रकार के अनुसार 'फोन' या 'टैबलेट' या 'स्मार्ट डिवाइस' पर क्लिक करें।</sys:String>
	<sys:String x:Key="K0955"  xml:space="preserve">आपके फोन के लिए उचित फर्मवेयर का चयन हो जाने के बाद, लक्ष्य फर्मवेयर फ़ाइल को डाउनलोड करने के लिए 'डाउनलोड' पर क्लिक करें।</sys:String>
	<sys:String x:Key="K0956"  xml:space="preserve">डाउनलोडिंग समाप्त होने के बाद, फ्लैशिंग करने के लिए 'स्टार्ट रेस्क्यू' पर क्लिक करें।</sys:String>
	<sys:String x:Key="K0957"  xml:space="preserve">अपने टैबलेट में डिबग मोड सक्षम करने के लिए निर्देशों का पालन करें, और फिर इसे यूएसबी केबल के माध्यम से पीसी से कनेक्ट करें।</sys:String>
	<sys:String x:Key="K0958"  xml:space="preserve">सॉफ्टवेयर फिक्स आपके कनेक्टेड टैबलेट के लिए उचित फर्मवेयर का मिलान करेगा, लक्ष्य फर्मवेयर फ़ाइल को डाउनलोड करने के लिए 'डाउनलोड' पर क्लिक करें।</sys:String>
	<sys:String x:Key="K0959"  xml:space="preserve">अपने टैबलेट का एसएन नंबर डालें, और फिर उचित फर्मवेयर से मिलान करने के लिए 'मैग्नीफायर' बटन पर क्लिक करें। &#x0a;यदि आपको अपने टैबलेट का एसएन नंबर नहीं पता है, तो 'एसएन कैसे खोजें?' लिंक पर क्लिक करें।</sys:String>
	<sys:String x:Key="K0960"  xml:space="preserve">आपके टैबलेट के लिए उचित फर्मवेयर का चयन हो जाने के बाद, लक्ष्य फर्मवेयर फ़ाइल को डाउनलोड करने के लिए 'डाउनलोड' पर क्लिक करें।</sys:String>
	<sys:String x:Key="K0961"  xml:space="preserve">अपने फोन का IMEI नंबर डालें, और फिर उचित फर्मवेयर से मिलान करने के लिए 'मैग्निफायर' बटन पर क्लिक करें।</sys:String>
	<sys:String x:Key="K0962"  xml:space="preserve">कृपया सुनिश्चित करें कि केवल एक डिवाइस कनेक्ट है, फिर बचाव का पुनः प्रयास करें।</sys:String>
	<sys:String x:Key="K0963"  xml:space="preserve">ऊपर से अनपिन करें</sys:String>
	<sys:String x:Key="K0964"  xml:space="preserve">ट्यूटोरियल - अपने डिवाइस को कैसे बचाएं</sys:String>
	<sys:String x:Key="K0965"  xml:space="preserve">कनेक्ट करना विफल रहा, क्योंकि आपने &quot;अनुमति आवश्यक&quot; प्रॉम्प्ट को अस्वीकार कर दिया। आप डिवाइस को फिर से कनेक्ट कर सकते हैं और पुनः प्रयास कर सकते हैं।</sys:String>
	<sys:String x:Key="K0966"  xml:space="preserve">कृपया चरणों का पालन करें:&#x0a;1. अपने डिवाइस को बंद करें।&#x0a;2. USB केबल को PC से कनेक्ट करें।&#x0a;3. अपने डिवाइस पर वॉल्यूम डाउन कुंजी को दबाकर रखें और USB केबल को अपने डिवाइस से कनेक्ट करें।&#x0a;4. फ़ोन डिस्प्ले पर हरे रंग का Android दिखाई देने पर वॉल्यूम डाउन कुंजी को छोड़ दें।</sys:String>
	<sys:String x:Key="K0967"  xml:space="preserve">यदि आपको डिवाइस पर चार्जिंग आइकन दिखाई देता है, तो कृपया डिवाइस को पुनः कनेक्ट करें और पुनः प्रयास करें।</sys:String>
	<sys:String x:Key="K0968"  xml:space="preserve"> सॉफ़्टवेयर फ़िक्स पीसी से कनेक्टेड डिवाइस का पता लगाता है, और डिवाइस के लिए फ़र्मवेयर का मिलान करता है। विवरण की जाँच करने के लिए ओके पर क्लिक करें, मैन्युअल चयन जारी रखने के लिए कैंसिल पर क्लिक करें।</sys:String>
	<sys:String x:Key="K0969"  xml:space="preserve">क्या आप फर्मवेयर मिलान बंद करने के लिए आश्वस्त हैं?</sys:String>
	<sys:String x:Key="K0970"  xml:space="preserve">1. सुनिश्चित करें कि आपका डिवाइस बंद है और पीसी से कनेक्ट नहीं है।&#x0a;2. वॉल्यूम &quot;+&quot; बटन दबाएं और उसी समय डिवाइस को यूएसबी के माध्यम से पीसी से कनेक्ट करें।&#x0a;3. जारी रखने के लिए ओके बटन पर क्लिक करें।&#x0a;4. प्रगति शुरू होने के बाद वॉल्यूम &quot;+&quot; बटन छोड़ दें।&#x0a;5. नोट: यदि आपको डिवाइस पर चार्जिंग आइकन दिखाई देता है, तो कृपया डिवाइस को फिर से कनेक्ट करें और पुनः प्रयास करें।</sys:String>
	<sys:String x:Key="K0971"  xml:space="preserve">1. सुनिश्चित करें कि आपका डिवाइस बंद है।&#x0a;2. डिवाइस को USB केबल के माध्यम से PC से कनेक्ट करें और जारी रखने के लिए OK बटन पर क्लिक करें।&#x0a;3. नोट: यदि आपको डिवाइस पर चार्जिंग आइकन दिखाई देता है, तो कृपया डिवाइस को फिर से कनेक्ट करें और पुनः प्रयास करें।</sys:String>
	<sys:String x:Key="K0972"  xml:space="preserve">1. डिवाइस को बंद करें, और इसे पीसी से डिस्कनेक्ट करें।&#x0a;2. वॉल्यूम अप कुंजी दबाते हुए, डिवाइस को यूएसबी केबल के साथ पीसी से कनेक्ट करें।&#x0a;3. जारी रखने के लिए ओके पर क्लिक करें।&#x0a;4. प्रगति शुरू होने के बाद वॉल्यूम कुंजी छोड़ दें।&#x0a;5. नोट: यदि आपको डिवाइस पर दिखाया गया चार्जिंग आइकन दिखाई देता है, तो कृपया डिवाइस को फिर से कनेक्ट करें और पुनः प्रयास करें।</sys:String>
	<sys:String x:Key="K0973"  xml:space="preserve">1. डिवाइस को बंद करें।&#x0a;2. डिवाइस को USB केबल से PC से कनेक्ट करें, फिर जारी रखने के लिए OK पर क्लिक करें।&#x0a;3. नोट: यदि आपको डिवाइस पर चार्जिंग आइकन दिखाई देता है, तो कृपया डिवाइस को पुनः कनेक्ट करें और पुनः प्रयास करें।</sys:String>
	<sys:String x:Key="K0974"  xml:space="preserve">यदि आप जानते हैं कि यूएसबी डिबग मोड को कैसे सक्षम किया जाता है, तो आप डिवाइस को डिबग मोड के माध्यम से कनेक्ट कर सकते हैं। सॉफ़्टवेयर फ़िक्स आपके लिए फ़र्मवेयर का स्वतः मिलान कर सकता है।</sys:String>
	<sys:String x:Key="K0975"  xml:space="preserve">अधिकांश डिवाइस डिवाइस को ऐसे मोड में स्विच करने का समर्थन करते हैं जो स्वचालित रूप से IMEI को पढ़ सकता है। क्या आप यह कैसे करें, इस पर निर्देश देखना चाहेंगे?</sys:String>
	<sys:String x:Key="K0976"  xml:space="preserve">क्या आप पहले से ही अपने डिवाइस का बाज़ार नाम और मॉडल जानते हैं? यदि हाँ, तो अपने डिवाइस का चयन करने के लिए मैन्युअल विधि का उपयोग करें।</sys:String>
	<sys:String x:Key="K0977"  xml:space="preserve">हमें आपके डिवाइस मॉडल का पता लगाने में परेशानी हो रही है। अच्छी खबर यह है कि आज़माने के लिए अतिरिक्त विकल्प भी हैं। कृपया नीचे दिए गए विकल्प को चुनें जो आपके लिए सबसे अच्छा काम करता है:</sys:String>
	<sys:String x:Key="K0978"  xml:space="preserve">IMEI अमान्य है</sys:String>
	<sys:String x:Key="K0979"  xml:space="preserve">आपका IMEI अमान्य है, कृपया जाँचें और पुनः प्रयास करें.</sys:String>
	<sys:String x:Key="K0980"  xml:space="preserve">सॉफ़्टवेयर फ़िक्स ने पाया है कि आपके डिवाइस मॉडल नाम में त्रुटि है, फ़्लैशिंग द्वारा डिवाइस को होने वाले नुकसान से बचने के लिए, सॉफ़्टवेयर फ़िक्स अनुशंसा करता है कि आप सहायता के लिए ग्राहक केंद्र पर जाएँ या आप वेबसाइट [a]https://motorola-global-portal.custhelp.com[/a] के माध्यम से सहायता पा सकते हैं।</sys:String>
	<sys:String x:Key="K0981"  xml:space="preserve">निम्नलिखित विकल्पों में से किसी एक का चयन करें जो आपके डिवाइस के लिए सर्वाधिक उपयुक्त हो, और सॉफ्टवेयर फिक्स मिलान किए गए फर्मवेयर की पुष्टि कर सकता है।</sys:String>
	<sys:String x:Key="K0982"  xml:space="preserve">सॉफ्टवेयर फिक्स आपके लिए उपयुक्त फर्मवेयर प्रदान करेगा।</sys:String>
	<sys:String x:Key="K0983"  xml:space="preserve">इंटरनेट उपलब्ध नहीं है, कृपया बाद में पुनः प्रयास करें।</sys:String>
	<sys:String x:Key="K0984"  xml:space="preserve"> आपका IMEI है</sys:String>
	<sys:String x:Key="K0985"  xml:space="preserve">आपके पीसी में डिस्क स्पेस अपर्याप्त है, जो सॉफ़्टवेयर फ़िक्स के सामान्य उपयोग को प्रभावित कर सकता है। कृपया डिस्क स्पेस खाली करें।</sys:String>
	<sys:String x:Key="K0986"  xml:space="preserve">1. पावर एडाप्टर निकालें।&#x0a;2. वॉल्यूम अप और वॉल्यूम डाउन कुंजी को एक साथ दबाएं, फिर एडाप्टर को फिर से कनेक्ट करें।&#x0a;3. दोनों वॉल्यूम कुंजियाँ छोड़ दें।&#x0a;4. डिवाइस को USB टाइप-सी केबल के साथ पीसी से कनेक्ट करें।</sys:String>
	<sys:String x:Key="K0987"  xml:space="preserve">1. आपका डिवाइस बचाव सफल हुआ, USB टाइप-सी केबल निकालें।&#x0a;2. बूट होने में कई मिनट लगते हैं, कृपया प्रतीक्षा करें।</sys:String>
	<sys:String x:Key="K0988"  xml:space="preserve">फास्टबूट मोड को कैसे चालू करें</sys:String>
	<sys:String x:Key="K0989"  xml:space="preserve">अमान्य IMEI नंबर</sys:String>
	<sys:String x:Key="K0990"  xml:space="preserve">फिर से चुनें</sys:String>
	<sys:String x:Key="K0991"  xml:space="preserve">1. सुनिश्चित करें कि आपका डिवाइस बंद है और पीसी से कनेक्ट नहीं है।&#x0a;2. वॉल्यूम &quot;+&quot; बटन दबाएं और उसी समय डिवाइस को यूएसबी के माध्यम से पीसी से कनेक्ट करें।&#x0a;3. जारी रखने के लिए ओके बटन पर क्लिक करें।&#x0a;4. प्रगति शुरू होने के बाद वॉल्यूम &quot;+&quot; बटन छोड़ दें।</sys:String>
	<sys:String x:Key="K0992"  xml:space="preserve">कनेक्टेड डिवाइस फ़र्मवेयर से मेल नहीं खाता, कृपया मेल खाने वाले फ़र्मवेयर से बदलें.&#x0a;आपका डिवाइस {0} है</sys:String>
	<sys:String x:Key="K0993"  xml:space="preserve">जाँचें कि छवि कनेक्टेड डिवाइस से मेल खाती है या नहीं</sys:String>
	<sys:String x:Key="K0994"  xml:space="preserve">www.lenovo.com/privacy/</sys:String>
	<sys:String x:Key="K0995"  xml:space="preserve">पथ</sys:String>
	<sys:String x:Key="K0996"  xml:space="preserve">15 अंक</sys:String>
	<sys:String x:Key="K0997"  xml:space="preserve">अगर मेरा फ़ोन फ़ास्टबूट मोड का समर्थन नहीं करता तो क्या होगा? यहाँ क्लिक करें:</sys:String>
	<sys:String x:Key="K0998"  xml:space="preserve">अनुशंसित</sys:String>
	<sys:String x:Key="K0999"  xml:space="preserve">डिवाइस को अपने पीसी से कनेक्ट करने के लिए ट्यूटोरियल का पालन करें। उसके बाद, सॉफ़्टवेयर फिक्स आपका मार्गदर्शन करेगा और आपके डिवाइस के लिए संबंधित फ़र्मवेयर से मेल खाएगा।</sys:String>
	<sys:String x:Key="K1000"  xml:space="preserve">यदि आपको पहले से पता है कि आपके पास कौन सा मॉडल है, तो उसे सूची से चुनें और फिर सॉफ्टवेयर फिक्स आपको बताएगा कि आगे क्या करना है।</sys:String>
	<sys:String x:Key="K1001"  xml:space="preserve">उत्पाद का नाम कैसे खोजें</sys:String>
	<sys:String x:Key="K1002"  xml:space="preserve">डिवाइस पर खोजें</sys:String>
	<sys:String x:Key="K1003"  xml:space="preserve">फ्लैश निर्देश</sys:String>
	<sys:String x:Key="K1004"  xml:space="preserve">चरण 2: 'फ़ोन के बारे में' स्क्रीन में, 'मॉडल और हार्डवेयर' मेनू चुनें। इसे खोलने के बाद नीचे 'अगला' बटन चुनें।</sys:String>
	<sys:String x:Key="K1005"  xml:space="preserve">चरण 3: अब आप अपने फोन का मॉडल नंबर देख पाएंगे। अधिकांश मॉडल नंबर 'XT' से शुरू होते हैं।</sys:String>
	<sys:String x:Key="K1006"  xml:space="preserve">फर्मवेयर मेल खा रहा है...</sys:String>
	<sys:String x:Key="K1007"  xml:space="preserve">सॉफ्टवेयर फिक्स आपको अपने डिवाइस को पीसी से कनेक्ट करने और सही फर्मवेयर का पता लगाने के लिए चरणों के माध्यम से मार्गदर्शन करेगा।</sys:String>
	<sys:String x:Key="K1008"  xml:space="preserve">चरण 3. अपने डिवाइस पर वॉल्यूम डाउन कुंजी को दबाकर रखें और यूएसबी केबल को अपने डिवाइस से कनेक्ट करें।&#x0a;चरण 4. फोन के डिस्प्ले पर हरे रंग का एंड्रॉइड दिखाई देने पर अपने डिवाइस पर वॉल्यूम डाउन कुंजी को छोड़ दें।</sys:String>
	<sys:String x:Key="K1009"  xml:space="preserve">यूएसबी केबल कनेक्ट प्रक्रिया</sys:String>
	<sys:String x:Key="K1010"  xml:space="preserve">सूची से अपना मॉडल चुनें</sys:String>
	<sys:String x:Key="K1011"  xml:space="preserve">आपने नीचे दिए अनुसार फर्मवेयर का चयन किया है, कृपया सुनिश्चित करें कि फर्मवेयर आपके डिवाइस से मेल खाता है।</sys:String>
	<sys:String x:Key="K1012"  xml:space="preserve">बचाव शुरू करने के लिए, आपके डिवाइस को फास्टबूट मोड में कनेक्ट किया जाना चाहिए। क्या आप अपने डिवाइस को पीसी से कनेक्ट करने के तरीके पर एक ट्यूटोरियल देखना चाहेंगे?</sys:String>
	<sys:String x:Key="K1013"  xml:space="preserve">ट्यूटोरियल - फास्टबूट मोड पर कैसे स्विच करें</sys:String>
	<sys:String x:Key="K1014"  xml:space="preserve">अपने डिवाइस को USB केबल से कनेक्ट करने के लिए चरण-दर-चरण निर्देशों का पालन करें। सफलतापूर्वक कनेक्ट होने के बाद, सॉफ़्टवेयर फ़िक्स उपयोग करने के लिए सही फ़र्मवेयर की पुष्टि करेगा।</sys:String>
	<sys:String x:Key="K1015"  xml:space="preserve">सुझाव: कृपया टैबलेट का उपयोग पोर्ट्रेट मोड में करें।</sys:String>
	<sys:String x:Key="K1016"  xml:space="preserve">एक-क्लिक-क्लोन बलपूर्वक रोका गया!</sys:String>
	<sys:String x:Key="K1017"  xml:space="preserve">बचाव शुरू करें</sys:String>
	<sys:String x:Key="K1018"  xml:space="preserve">REPLAY</sys:String>
	<sys:String x:Key="K1019"  xml:space="preserve">हमारे एप्लिकेशन का उपयोग करने के लिए धन्यवाद।</sys:String>
	<sys:String x:Key="K1020"  xml:space="preserve">कृपया निम्नलिखित प्रश्नों के उत्तर देने में कुछ समय लें ताकि हम इसे बेहतर बना सकें।</sys:String>
	<sys:String x:Key="K1021"  xml:space="preserve">1. आप सॉफ्टवेयर फिक्स एप्लीकेशन को कैसे रेट करेंगे?</sys:String>
	<sys:String x:Key="K1022"  xml:space="preserve">2. क्या यह एप्लीकेशन आपके लिए उपयोगी है?</sys:String>
	<sys:String x:Key="K1023"  xml:space="preserve">कृपया हमारे आवेदन को रेटिंग दें।</sys:String>
	<sys:String x:Key="K1024"  xml:space="preserve">कृपया हमें बताएं कि क्या यह एप्लीकेशन आपके लिए उपयोगी है।</sys:String>
	<sys:String x:Key="K1025"  xml:space="preserve">इस सर्वेक्षण को पूरा करने के लिए धन्यवाद!</sys:String>
	<sys:String x:Key="K1026"  xml:space="preserve">आप चरण में प्रवेश करने के लिए ड्रॉप-डाउन मेनू विकल्पों में से कोई भी विकल्प चुन सकते हैं।</sys:String>
	<sys:String x:Key="K1027"  xml:space="preserve">स्क्रीन मिरर</sys:String>
	<sys:String x:Key="K1028"  xml:space="preserve">स्क्रीन मिररिंग और आपके पीसी पर प्रोजेक्टिंग</sys:String>
	<sys:String x:Key="K1029"  xml:space="preserve">डिवाइस नेटवर्क कनेक्शन विफल.</sys:String>
	<sys:String x:Key="K1030"  xml:space="preserve">स्क्रीन मिरर के लिए आवश्यक है कि आपका डिवाइस और पीसी एक ही नेटवर्क सेगमेंट में हों। कृपया अपने डिवाइस को पीसी के साथ एक ही वाईफाई से कनेक्ट करने के बाद पुनः प्रयास करें।</sys:String>
	<sys:String x:Key="K1031"  xml:space="preserve">यदि आपके पास वाई-फाई उपलब्ध नहीं है, तो आप मोबाइल हॉटस्पॉट के माध्यम से कनेक्ट कर सकते हैं।</sys:String>
	<sys:String x:Key="K1033"  xml:space="preserve">सॉफ्टवेयर फिक्स स्क्रीन मिररिंग को मोबाइल असिस्ट ऐप के साथ उपयोग करने की आवश्यकता है। क्या आपने अपने डिवाइस पर MA ऐप इंस्टॉल किया है?</sys:String>
	<sys:String x:Key="K1034"  xml:space="preserve">कृपया अपने डिवाइस को PC से जोड़ें ताकि आप MA ऐप को इनस्टॉल कर सकें।</sys:String>
	<sys:String x:Key="K1035"  xml:space="preserve">डिवाइस को कनेक्ट करने से पहले, कृपया USB डिबगिंग शुरू करने के लिए निम्नलिखित 3 चरणों का संदर्भ लें:</sys:String>
	<sys:String x:Key="K1036"  xml:space="preserve">अपने डिवाइस को पीसी के समान वाईफाई से कनेक्ट करें, फिर स्क्रीन मिररिंग शुरू करने के लिए निम्नलिखित &quot;प्रारंभ&quot; बटन पर क्लिक करें।</sys:String>
	<sys:String x:Key="K1037"  xml:space="preserve">WiFi के माध्यम से स्क्रीन मिररिंग का उपयोग करें</sys:String>
	<sys:String x:Key="K1038"  xml:space="preserve">1. अपने डिवाइस को पीसी के समान वाईफाई से कनेक्ट करें।</sys:String>
	<sys:String x:Key="K1039"  xml:space="preserve">2. कनेक्ट करने के लिए निम्नलिखित QR कोड को स्कैन करने के लिए मोबाइल सहायक ऐप का उपयोग करें।</sys:String>
	<sys:String x:Key="K1040"  xml:space="preserve">3. स्क्रीन मिररिंग शुरू करने के लिए निम्नलिखित &quot;प्रारंभ&quot; बटन पर क्लिक करें।</sys:String>
	<sys:String x:Key="K1041"  xml:space="preserve">यदि आप कनेक्ट करने के लिए क्यूआर कोड को स्कैन नहीं करना चाहते हैं, तो आप सीधे एमए में आईपी दर्ज कर सकते हैं, आपका आईपी पता है</sys:String>
	<sys:String x:Key="K1042"  xml:space="preserve">नया डिवाइस कनेक्शन पता चला है, मेल खाते फर्मवेयर की प्रतीक्षा करें</sys:String>
	<sys:String x:Key="K1043"  xml:space="preserve">कृपया सुनिश्चित करें कि बचाव उपकरण दर्ज किए गए IMEI नंबर के समान है।</sys:String>
	<sys:String x:Key="K1045"  xml:space="preserve">सॉफ़्टवेयर फ़िक्स ने पता लगाया है कि आप किसी डिवाइस से जुड़े हैं, स्वचालित रूप से पृष्ठभूमि में फर्मवेयर का मिलान करेगा।</sys:String>
	<sys:String x:Key="K1046"  xml:space="preserve">आप {0} नंबर दर्ज करने का प्रयास कर सकते हैं या स्वयं मैन्युअल रूप से फर्मवेयर का चयन कर सकते हैं।</sys:String>
	<sys:String x:Key="K1047"  xml:space="preserve">अपने मिरर किए गए डिवाइस पर ऐप इंस्टॉल करें</sys:String>
	<sys:String x:Key="K1048"  xml:space="preserve">सॉफ्टवेयर फिक्स स्क्रीन मिररिंग को मोबाइल असिस्टेंट ऐप के साथ उपयोग करने की आवश्यकता है। क्या आपने अपने डिवाइस पर MA ऐप इंस्टॉल किया है?</sys:String>
	<sys:String x:Key="K1049"  xml:space="preserve">स्थापित नहीं हे</sys:String>
