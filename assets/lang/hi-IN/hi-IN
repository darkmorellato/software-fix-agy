	<sys:String x:Key="K1448"  xml:space="preserve">बाहर निकलना</sys:String>
	<sys:String x:Key="K1449"  xml:space="preserve">कनेक्शन प्रक्रिया समाप्त</sys:String>
	<sys:String x:Key="K1450"  xml:space="preserve">आप मेरा डिवाइस, बैकअप और पुनर्स्थापना आदि तक नहीं पहुंच सकते क्योंकि आपने मोबाइल सहायक ऐप इंस्टॉल करने से इनकार कर दिया है।</sys:String>
	<sys:String x:Key="K1451"  xml:space="preserve">डिवाइस FASTBOOT मॉडल से जुड़ा हुआ है, आप इस पर स्विच नहीं कर सकते।</sys:String>
	<sys:String x:Key="K1452"  xml:space="preserve">फ्लैश विफल हो गया। USB केबल या USB पोर्ट ढीला है। सुनिश्चित करें कि प्लग कसकर लगा हो, और फिर से प्रयास करें।&#x0a;(USB पोर्ट हब का उपयोग करने की अनुशंसा नहीं की जाती है।)</sys:String>
	<sys:String x:Key="K1453"  xml:space="preserve">Moto E13 (XT2345), Moto G14 (XT2341), Moto G04 (XT2421), Moto G35 5G (XT2433)</sys:String>
	<sys:String x:Key="K1454"  xml:space="preserve">कोई फ़ास्टबूट डिवाइस नहीं मिला, हो सकता है डिवाइस का ड्राइवर सही ढंग से स्थापित नहीं है!</sys:String>
	<sys:String x:Key="K1455"  xml:space="preserve">अपने डिवाइस को पीसी के समान वाई-फाई से कनेक्ट करें।</sys:String>
	<sys:String x:Key="K1456"  xml:space="preserve">अपने फ़ोन पर डिवाइस सहायता ऐप खोजें.</sys:String>
	<sys:String x:Key="K1457"  xml:space="preserve">डिवाइस सहायता ऐप के अंदर, स्क्रीन के शीर्ष पर हमिंगबर्ड आइकन पर टैप करें और &quot;कनेक्ट करने के लिए स्कैन करें&quot; विकल्प चुनें।</sys:String>
	<sys:String x:Key="K1458"  xml:space="preserve">वाई-फाई से कनेक्ट करने के लिए डिवाइस सहायता ऐप का उपयोग करके कोड को स्कैन करें।</sys:String>
	<sys:String x:Key="K1459"  xml:space="preserve">आपका डिवाइस अन्य क्षेत्रों से फर्मवेयर फ्लैश करने का समर्थन नहीं करता है</sys:String>
	<sys:String x:Key="K1461"  xml:space="preserve">अगर आपके फ़ोन में डिवाइस हेल्प ऐप इंस्टॉल नहीं है, तो [a]rasa.page.link/ma[/a] से मोबाइल असिस्टेंट ऐप इंस्टॉल करें। इंस्टॉल हो जाने के बाद, ऊपर दिए गए QR कोड को स्कैन करने के लिए ऐप का इस्तेमाल करें।</sys:String>
	<sys:String x:Key="K1462"  xml:space="preserve">कनेक्ट करने के अतिरिक्त तरीके यहां देखे जा सकते हैं</sys:String>
