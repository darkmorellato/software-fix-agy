	<sys:String x:Key="K1464"  xml:space="preserve">कृपया वाईफ़ाई से कनेक्ट करने के लिए नीचे दिए गए चरणों का पालन करें</sys:String>
	<sys:String x:Key="K1465"  xml:space="preserve">डिवाइस की जानकारी पढ़ने और फ़र्मवेयर से मिलान करने के लिए अपने फ़ोन को WiFi का उपयोग करके सॉफ़्टवेयर फ़िक्स से कनेक्ट करें</sys:String>
	<sys:String x:Key="K1466"  xml:space="preserve">IMEI मैन्युअल रूप से दर्ज करें</sys:String>
	<sys:String x:Key="K1467"  xml:space="preserve">अपना मॉडल चुनें</sys:String>
	<sys:String x:Key="K1468"  xml:space="preserve">अपना फ़ोन मॉडल चुनने के लिए निर्देशों का पालन करें</sys:String>
	<sys:String x:Key="K1469"  xml:space="preserve">सही फर्मवेयर से मिलान करने के लिए अपने फ़ोन का IMEI दर्ज करें</sys:String>
	<sys:String x:Key="K1460"  xml:space="preserve">कनेक्ट करने के अतिरिक्त तरीके</sys:String>
	<sys:String x:Key="K1470"  xml:space="preserve">जल्दी से जाँच करके देखें कि क्या आपके डिवाइस में कोई हार्डवेयर समस्या है</sys:String>
	<sys:String x:Key="K1471"  xml:space="preserve">WiFi का उपयोग करके कनेक्ट करने के लिए डिवाइस सहायता या मोबाइल सहायक ऐप का उपयोग करके नीचे दिए गए कोड को स्कैन करें</sys:String>
	<sys:String x:Key="K1472"  xml:space="preserve">WiFi कनेक्ट चरण देखें</sys:String>
	<sys:String x:Key="K1473"  xml:space="preserve">अपना खुद का चलायें</sys:String>
	<sys:String x:Key="K1474"  xml:space="preserve">हार्डवेयर परीक्षण</sys:String>
	<sys:String x:Key="K1475"  xml:space="preserve">आपके फ़ोन पर डिवाइस सहायता ऐप का संस्करण हार्डवेयर परीक्षण का समर्थन नहीं करता है. क्या आप हार्डवेयर परीक्षण का समर्थन करने के लिए मोबाइल सहायक ऐप इंस्टॉल करना चाहेंगे?</sys:String>
	<sys:String x:Key="K1476"  xml:space="preserve">कृपया वाईफ़ाई से कनेक्ट करने के लिए नीचे दिए गए चरणों का पालन करें</sys:String>
	<sys:String x:Key="K1477"  xml:space="preserve">सुनिश्चित करें कि आपका डिवाइस और पीसी दोनों एक ही वाई-फाई नेटवर्क से जुड़े हों</sys:String>
	<sys:String x:Key="K1478"  xml:space="preserve">कनेक्टेड डिवाइस अपेक्षित शिपिंग सॉफ्टवेयर मूल्यों से मेल नहीं खाता है और रेस्क्यू नहीं चलाया जा सकता है। कृपया अपेक्षित मूल्यों पर वापस प्रोग्राम करने के लिए मेल करें या अधिकृत मोटोरोला सेवा केंद्र का पता लगाएं।</sys:String>
	<sys:String x:Key="K1479"  xml:space="preserve">अपने फोन पर डिवाइस सहायता ऐप खोलें।&#x0a;- ऐप खुलने के बाद, 'सॉफ़्टवेयर फ़िक्स' कार्ड टैप करें।&#x0a;- &quot;स्कैन टू कनेक्ट&quot; विकल्प का चयन करें।&#x0a;- आवश्यक अनुमतियाँ प्रदान करें।</sys:String>
	<sys:String x:Key="K1480"  xml:space="preserve">छवि में दिखाए गए क्यूआर कोड को स्कैन करें और संकेत मिलने पर पिन # दर्ज करें। पिन # दर्ज करने के बाद, आपका डिवाइस स्वचालित रूप से वाई-फाई से कनेक्ट हो जाएगा और सॉफ्टवेयर फिक्स ऐप में विवरण दिखाई देगा</sys:String>
	<sys:String x:Key="K1481"  xml:space="preserve">यदि आपके डिवाइस में डिवाइस हेल्प ऐप नहीं है, तो अपने डिवाइस पर मोबाइल असिस्टेंट &quot;MA&quot; ऐप इंस्टॉल करने के लिए इन निर्देशों का पालन करें:&#x0a;- MA ऐप apk फ़ाइल डाउनलोड करने के लिए छवि में दिखाए गए QR कोड को स्कैन करें &#x0a;- संकेत मिलने पर ऐप इंस्टॉल करें &#x0a;- इंस्टॉल हो जाने पर, MA ऐप खोलें</sys:String>
	<sys:String x:Key="K1482"  xml:space="preserve">एमए ऐप में, &quot;क्यूआर कोड स्कैन करें&quot; विकल्प चुनें - एक बार चयन करने के बाद, चित्रों को अधिकृत करने की अनुमति स्वीकार करना सुनिश्चित करें</sys:String>
