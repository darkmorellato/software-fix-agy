<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SoftwareFix.UI.App"
             xmlns:local="using:SoftwareFix.UI"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Conversores -->
        <local:EqualsValueConverter x:Key="EqualsConverter" />

        <!-- ================================================================ -->
        <!-- Paleta Oficial — tokens extraídos dos XAML descompilados de      -->
        <!-- lenovo.themes.generic (tema v6) e do Software Fix.exe.           -->
        <!-- Referência completa: docs/DESIGN_TOKENS.md                       -->
        <!-- ================================================================ -->
        <Color x:Key="TopBarBgColor">#001429</Color>
        <Color x:Key="ActiveTabTealColor">#005D7F</Color>
        <Color x:Key="ActionPillTealColor">#005D7F</Color>
        <Color x:Key="WelcomeBgColor">#041122</Color>
        <Color x:Key="WelcomeCardBgColor">#0C233B</Color>
        <Color x:Key="WelcomeCardHoverColor">#133152</Color>
        <Color x:Key="LenovoRedColor">#E2231A</Color>
        <Color x:Key="NoticeOrangeColor">#FF6F43</Color>
        <Color x:Key="GreenSuccessColor">#40A995</Color>
        <Color x:Key="ConnectedWhiteBgColor">#FFFFFF</Color>

        <!-- Tokens oficiais adicionais (tema lenovo.themes.generic v6) -->
        <Color x:Key="V6PrimaryColor">#005D7F</Color>       <!-- azul-marinho primário (139x no tema) -->
        <Color x:Key="V6DeepColor">#001429</Color>          <!-- fundo escuro (110x) -->
        <Color x:Key="V6SteelColor">#345375</Color>         <!-- azul aço secundário (99x) -->
        <Color x:Key="V6AccentColor">#43B5E2</Color>        <!-- azul claro de destaque (98x) -->
        <Color x:Key="V6AccentLightColor">#6EC2ED</Color>   <!-- azul claro hover (29x) -->
        <Color x:Key="V6MutedTextColor">#9FAEBF</Color>     <!-- texto secundário (65x) -->
        <Color x:Key="V6BorderColor">#D4DCE3</Color>        <!-- bordas claras (49x) -->
        <Color x:Key="V6DarkTextColor">#494949</Color>      <!-- texto escuro (29x) -->
        <Color x:Key="V6SlateTextColor">#6D86AB</Color>     <!-- texto cinza-azulado (24x) -->
        <Color x:Key="V6GrayTextColor">#AAAAAA</Color>      <!-- texto cinza (23x) -->
        <Color x:Key="V6DangerColor">#FF4042</Color>        <!-- vermelho de erro (19x) -->
        <Color x:Key="V6WarningColor">#FAAD14</Color>       <!-- amarelo de alerta (9x) -->
        <Color x:Key="V6InfoSoftColor">#CEEAF9</Color>      <!-- azul suave informativo (13x) -->

        <!-- Pincéis (Brushes) -->
        <SolidColorBrush x:Key="TopBarBgBrush" Color="{StaticResource TopBarBgColor}" />
        <SolidColorBrush x:Key="ActiveTabTealBrush" Color="{StaticResource ActiveTabTealColor}" />
        <!-- Azul da aba ativa do header (arte v7.4: bloco cheio com caimento no conteúdo) -->
        <SolidColorBrush x:Key="TopTabActiveBrush" Color="#16709F" />
        <SolidColorBrush x:Key="ActionPillTealBrush" Color="{StaticResource ActionPillTealColor}" />
        <SolidColorBrush x:Key="WelcomeBgBrush" Color="{StaticResource WelcomeBgColor}" />
        <SolidColorBrush x:Key="WelcomeCardBgBrush" Color="{StaticResource WelcomeCardBgColor}" />
        <SolidColorBrush x:Key="WelcomeCardHoverBrush" Color="{StaticResource WelcomeCardHoverColor}" />
        <SolidColorBrush x:Key="LenovoRedBrush" Color="{StaticResource LenovoRedColor}" />
        <SolidColorBrush x:Key="NoticeOrangeBrush" Color="{StaticResource NoticeOrangeColor}" />
        <SolidColorBrush x:Key="GreenSuccessBrush" Color="{StaticResource GreenSuccessColor}" />
        <SolidColorBrush x:Key="ConnectedWhiteBgBrush" Color="{StaticResource ConnectedWhiteBgColor}" />
        <SolidColorBrush x:Key="TextDarkNavyBrush" Color="#001429" />
        <SolidColorBrush x:Key="TextMutedBlueBrush" Color="#9FAEBF" />
        <SolidColorBrush x:Key="TextSpecsLabelBrush" Color="#64748B" />
        <SolidColorBrush x:Key="TextSpecsValueBrush" Color="#1E293B" />

        <!-- Tokens oficiais V6 (brushes) -->
        <SolidColorBrush x:Key="V6PrimaryBrush" Color="{StaticResource V6PrimaryColor}" />
        <SolidColorBrush x:Key="V6AccentBrush" Color="{StaticResource V6AccentColor}" />
        <SolidColorBrush x:Key="V6DangerBrush" Color="{StaticResource V6DangerColor}" />
        <SolidColorBrush x:Key="V6WarningBrush" Color="{StaticResource V6WarningColor}" />

        <!-- Gradiente da Tela Welcome -->
        <LinearGradientBrush x:Key="WelcomeGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#030E1D" />
            <GradientStop Offset="1" Color="#07192C" />
        </LinearGradientBrush>

        <!-- Ícones Vetoriais Oficiais SVG (StreamGeometry) -->
        <!-- Top Bar: Multiple Devices Selector -->
        <StreamGeometry x:Key="IconDevicesThree">M4,6H2v14c0,1.1 0.9,2 2,2h14v-2H4V6z M20,2H8C6.9,2 6,2.9 6,4v12c0,1.1 0.9,2 2,2h12c1.1,0 2,-0.9 2,-2V4C22,2.9 21.1,2 20,2z M20,16H8V4h12V16z</StreamGeometry>
        
