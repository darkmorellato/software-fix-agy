<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SoftwareFix.UI.App"
             xmlns:local="using:SoftwareFix.UI"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- ================================================================ -->
        <!-- Paleta Oficial — tokens extraídos dos XAML descompilados de      -->
        <!-- lenovo.themes.generic (tema v6) e do Software Fix.exe.           -->
        <!-- Referência completa: docs/DESIGN_TOKENS.md                       -->
        <!-- ================================================================ -->
        <Color x:Key="TopBarBgColor">#001429</Color>
        <Color x:Key="ActiveTabTealColor">#005D7F</Color>
        <Color x:Key="ActionPillTealColor">#005D7F</Color>
        <Color x:Key="WelcomeBgColor">#041122</Color>
        <Color x:Key="WelcomeCardBgColor">#0C233B</Color>
        <Color x:Key="WelcomeCardHoverColor">#133152</Color>
        <Color x:Key="LenovoRedColor">#E2231A</Color>
        <Color x:Key="NoticeOrangeColor">#FF6F43</Color>
        <Color x:Key="GreenSuccessColor">#40A995</Color>
        <Color x:Key="ConnectedWhiteBgColor">#FFFFFF</Color>

        <!-- Tokens oficiais adicionais (tema lenovo.themes.generic v6) -->
        <Color x:Key="V6PrimaryColor">#005D7F</Color>       <!-- azul-marinho primário (139x no tema) -->
        <Color x:Key="V6DeepColor">#001429</Color>          <!-- fundo escuro (110x) -->
        <Color x:Key="V6SteelColor">#345375</Color>         <!-- azul aço secundário (99x) -->
        <Color x:Key="V6AccentColor">#43B5E2</Color>        <!-- azul claro de destaque (98x) -->
        <Color x:Key="V6AccentLightColor">#6EC2ED</Color>   <!-- azul claro hover (29x) -->
        <Color x:Key="V6MutedTextColor">#9FAEBF</Color>     <!-- texto secundário (65x) -->
        <Color x:Key="V6BorderColor">#D4DCE3</Color>        <!-- bordas claras (49x) -->
        <Color x:Key="V6DarkTextColor">#494949</Color>      <!-- texto escuro (29x) -->
        <Color x:Key="V6SlateTextColor">#6D86AB</Color>     <!-- texto cinza-azulado (24x) -->
        <Color x:Key="V6GrayTextColor">#AAAAAA</Color>      <!-- texto cinza (23x) -->
        <Color x:Key="V6DangerColor">#FF4042</Color>        <!-- vermelho de erro (19x) -->
        <Color x:Key="V6WarningColor">#FAAD14</Color>       <!-- amarelo de alerta (9x) -->
        <Color x:Key="V6InfoSoftColor">#CEEAF9</Color>      <!-- azul suave informativo (13x) -->

        <!-- Pincéis (Brushes) -->
        <SolidColorBrush x:Key="TopBarBgBrush" Color="{StaticResource TopBarBgColor}" />
        <SolidColorBrush x:Key="ActiveTabTealBrush" Color="{StaticResource ActiveTabTealColor}" />
        <SolidColorBrush x:Key="ActionPillTealBrush" Color="{StaticResource ActionPillTealColor}" />
        <SolidColorBrush x:Key="WelcomeBgBrush" Color="{StaticResource WelcomeBgColor}" />
        <SolidColorBrush x:Key="WelcomeCardBgBrush" Color="{StaticResource WelcomeCardBgColor}" />
        <SolidColorBrush x:Key="WelcomeCardHoverBrush" Color="{StaticResource WelcomeCardHoverColor}" />
        <SolidColorBrush x:Key="LenovoRedBrush" Color="{StaticResource LenovoRedColor}" />
        <SolidColorBrush x:Key="NoticeOrangeBrush" Color="{StaticResource NoticeOrangeColor}" />
        <SolidColorBrush x:Key="GreenSuccessBrush" Color="{StaticResource GreenSuccessColor}" />
        <SolidColorBrush x:Key="ConnectedWhiteBgBrush" Color="{StaticResource ConnectedWhiteBgColor}" />
        <SolidColorBrush x:Key="TextDarkNavyBrush" Color="#001429" />
        <SolidColorBrush x:Key="TextMutedBlueBrush" Color="#9FAEBF" />
        <SolidColorBrush x:Key="TextSpecsLabelBrush" Color="#64748B" />
        <SolidColorBrush x:Key="TextSpecsValueBrush" Color="#1E293B" />

        <!-- Tokens oficiais V6 (brushes) -->
        <SolidColorBrush x:Key="V6PrimaryBrush" Color="{StaticResource V6PrimaryColor}" />
        <SolidColorBrush x:Key="V6AccentBrush" Color="{StaticResource V6AccentColor}" />
        <SolidColorBrush x:Key="V6DangerBrush" Color="{StaticResource V6DangerColor}" />
        <SolidColorBrush x:Key="V6WarningBrush" Color="{StaticResource V6WarningColor}" />

        <!-- Gradiente da Tela Welcome -->
        <LinearGradientBrush x:Key="WelcomeGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#030E1D" />
            <GradientStop Offset="1" Color="#07192C" />
        </LinearGradientBrush>

        <!-- Ícones Vetoriais Oficiais SVG (StreamGeometry) -->
        <!-- Top Bar: Multiple Devices Selector -->
        <StreamGeometry x:Key="IconDevicesThree">M4,6H2v14c0,1.1 0.9,2 2,2h14v-2H4V6z M20,2H8C6.9,2 6,2.9 6,4v12c0,1.1 0.9,2 2,2h12c1.1,0 2,-0.9 2,-2V4C22,2.9 21.1,2 20,2z M20,16H8V4h12V16z</StreamGeometry>
        
        <!-- Tab 1: Rescue (Crossed Wrench and Screwdriver) -->
        <StreamGeometry x:Key="IconRescueTools">M22.7,19l-9.1,-9.1c0.9,-2.3 0.4,-5 -1.5,-6.9c-2,-2 -5,-2.4 -7.4,-1.3L9,6L6,9L1.6,4.7C0.4,7.1 0.9,10.1 2.9,12.1c1.9,1.9 4.6,2.4 6.9,1.5l9.1,9.1c0.4,0.4 1,0.4 1.4,0l2.3,-2.3C23.1,20 23.1,19.4 22.7,19z</StreamGeometry>
        
        <!-- Tab 2: Backup & Restore -->
        <StreamGeometry x:Key="IconBackupRestore">M14,2H6C4.9,2 4,2.9 4,4v16c0,1.1 0.9,2 2,2h12c1.1,0 2,-0.9 2,-2V8L14,2z M12,18c-2.05,0 -3.81,-1.24 -4.58,-3h1.71c0.63,0.9 1.68,1.5 2.87,1.5 1.93,0 3.5,-1.57 3.5,-3.5S13.93,9.5 12,9.5c-1.07,0 -2.03,0.49 -2.67,1.25L11,12H6V7l1.79,1.79C8.79,7.66 10.31,7 12,7c3.04,0 5.5,2.46 5.5,5.5S15.04,18 12,18z</StreamGeometry>

        <!-- Tab 3: Hardware Test -->
        <StreamGeometry x:Key="IconHardwareTest">M9,11.24V7.5C9,6.12 10.12,5 11.5,5S14,6.12 14,7.5v3.74c1.21,-0.81 2,-2.18 2,-3.74C16,5.01 13.99,3 11.5,3S7,5.01 7,7.5C7,9.06 7.79,10.43 9,11.24z M18.84,15.25l-4.71,-2.36c-0.34,-0.17 -0.73,-0.22 -1.1,-0.15l-1.53,0.31v-5.55c0,-0.83 -0.67,-1.5 -1.5,-1.5s-1.5,0.67 -1.5,1.5v8.74l-3.32,-0.7c-0.36,-0.08 -0.74,0.03 -1.02,0.28l-0.89,0.8 5.65,5.65C9.28,22.84 9.79,23.1 10.32,23.1h7.11c0.97,0 1.78,-0.7 1.92,-1.66l0.72,-4.81C20.21,15.93 19.64,15.35 18.84,15.25z</StreamGeometry>

        <!-- Tab 4: Data Transfer -->
        <StreamGeometry x:Key="IconDataTransfer">M6.99,11L3,15l3.99,4v-3H14v-2H6.99v-3z M21,9l-3.99,-4v3H10v2h7.01v3L21,9z</StreamGeometry>

        <!-- Tab 5: My Device -->
        <StreamGeometry x:Key="IconMyDevice">M17,1.01L7,1C5.9,1 5,1.9 5,3v18c0,1.1 0.9,2 2,2h10c1.1,0 2,-0.9 2,-2V3C19,1.9 18.1,1.01 17,1.01z M17,19H7V5h10V19z</StreamGeometry>

        <!-- Tab 6: Toolbox -->
        <StreamGeometry x:Key="IconToolbox">M20,6h-4V4c0,-1.11 -0.89,-2 -2,-2h-4c-1.11,0 -2,0.89 -2,2v2H4c-1.11,0 -1.99,0.89 -1.99,2L2,19c0,1.11 0.89,2 2,2h16c1.11,0 2,-0.89 2,-2V8c0,-1.11 -0.89,-2 -2,-2z M10,4h4v2h-4V4z M20,19H4v-7h16v7z M20,10H4V8h16v2z</StreamGeometry>

        <!-- Tab 7: Support -->
        <StreamGeometry x:Key="IconSupport">M12,1c-4.97,0 -9,4.03 -9,9v7c0,2.21 1.79,4 4,4h1v-8H5v-3c0,-3.87 3.13,-7 7,-7s7,3.13 7,7v3h-3v8h1c2.21,0 4,-1.79 4,-4v-7c0,-4.97 -4.03,-9 -9,-9z</StreamGeometry>

        <!-- Ícone de celular (My Device) -->
        <StreamGeometry x:Key="IconPhone">M17,1.01L7,1C5.9,1 5,1.9 5,3v18c0,1.1 0.9,2 2,2h10c1.1,0 2,-0.9 2,-2V3C19,1.9 18.1,1.01 17,1.01z M17,19H7V5h10V19z</StreamGeometry>

        <!-- Motorola Batwing Official Logo -->
        <StreamGeometry x:Key="IconMotorola">M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2z M17.2,16.5c-1.3,0 -2.3,-1.2 -3.2,-2.7 -0.5,-0.9 -1,-1.8 -2,-1.8s-1.5,0.9 -2,1.8c-0.9,1.5 -1.9,2.7 -3.2,2.7 -1.2,0 -2.3,-0.8 -2.3,-2.3 0,-2.3 2.7,-6.2 5.5,-6.2 1,0 1.5,0.5 2,1.2 0.5,-0.7 1,-1.2 2,-1.2 2.8,0 5.5,3.9 5.5,6.2 0,1.5 -1.1,2.3 -2.3,2.3z</StreamGeometry>

        <!-- Android Robot -->
        <StreamGeometry x:Key="IconAndroid">M6,18c0,0.55 0.45,1 1,1h1v3.5c0,0.83 0.67,1.5 1.5,1.5s1.5,-0.67 1.5,-1.5V19h2v3.5c0,0.83 0.67,1.5 1.5,1.5s1.5,-0.67 1.5,-1.5V19h1c0.55,0 1,-0.45 1,-1V8H6v10z M3.5,8C2.67,8 2,8.67 2,9.5v7c0,0.83 0.67,1.5 1.5,1.5S5,17.33 5,16.5v-7C5,8.67 4.33,8 3.5,8z M20.5,8c-0.83,0 -1.5,0.67 -1.5,1.5v7c0,0.83 0.67,1.5 1.5,1.5s1.5,-0.67 1.5,-1.5v-7c0,-0.83 -0.67,-1.5 -1.5,-1.5z M15.53,2.16l1.3,-1.3c0.2,-0.2 0.2,-0.51 0,-0.71 -0.2,-0.2 -0.51,-0.2 -0.71,0l-1.48,1.48C13.68,1.24 12.6,1 11.5,1s-2.18,0.24 -3.14,0.63L6.88,0.15c-0.2,-0.2 -0.51,-0.2 -0.71,0 -0.2,0.2 -0.2,0.51 0,0.71l1.3,1.3C5.55,3.41 4.29,5.55 4.05,8h14.9C18.71,5.55 17.45,3.41 15.53,2.16z M8.5,5c-0.55,0 -1,-0.45 -1,-1s0.45,-1 1,-1 1,0.45 1,1 -0.45,1 -1,1z M14.5,5c-0.55,0 -1,-0.45 -1,-1s0.45,-1 1,-1 1,0.45 1,1 -0.45,1 -1,1z</StreamGeometry>

        <!-- Sucesso Checkmark -->
        <StreamGeometry x:Key="IconCheckCircle">M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2z M10,17l-5,-5 1.41,-1.41L10,14.17l7.59,-7.59L19,8l-9,9z</StreamGeometry>

        <!-- Outros utilitários -->
        <StreamGeometry x:Key="IconCopy">M16,1H4C2.9,1 2,1.9 2,3v14h2V3h12V1z M19,5H8C6.9,5 6,5.9 6,7v14c0,1.1 0.9,2 2,2h11c1.1,0 2,-0.9 2,-2V7C21,5.9 20.1,5 19,5z M19,21H8V7h11V21z</StreamGeometry>
        <StreamGeometry x:Key="IconDownload">M19.35,10.04C18.67,6.59 15.64,4 12,4 9.11,4 6.6,5.64 5.35,8.04 2.34,8.36 0,10.91 0,14c0,3.31 2.69,6 6,6h13c2.76,0 5,-2.24 5,-5 0,-2.64 -2.05,-4.78 -4.65,-4.96z M17,13l-5,5 -5,-5h3V9h4v4h3z</StreamGeometry>
        <StreamGeometry x:Key="IconTerminal">M20,4H4C2.89,4 2,4.89 2,6v12c0,1.11 0.89,2 2,2h16c1.11,0 2,-0.89 2,-2V6C22,4.89 21.11,4 20,4z M7.5,15L6.09,13.59 8.67,11 6.09,8.41 7.5,7l4,4L7.5,15z M17,15h-4v-2h4V15z</StreamGeometry>
        <StreamGeometry x:Key="IconSettings">M19.14,12.94c0.04,-0.3 0.06,-0.61 0.06,-0.94 0,-0.32 -0.02,-0.64 -0.07,-0.94l2.03,-1.58c0.18,-0.14 0.23,-0.41 0.12,-0.61l-1.92,-3.32c-0.12,-0.22 -0.37,-0.29 -0.59,-0.22l-2.39,0.96c-0.5,-0.38 -1.03,-0.7 -1.62,-0.94L14.4,2.81c-0.04,-0.24 -0.24,-0.41 -0.48,-0.41h-3.84c-0.24,0 -0.43,0.17 -0.47,0.41L9.25,5.35C8.66,5.59 8.12,5.92 7.63,6.29L5.24,5.33c-0.22,-0.08 -0.47,0 -0.59,0.22L2.74,8.87c-0.12,0.21 -0.08,0.47 0.12,0.61l2.03,1.58C4.84,11.36 4.8,11.69 4.8,12s0.02,0.64 0.07,0.94l-2.03,1.58c-0.18,0.14 -0.23,0.41 -0.12,0.61l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39,-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54c0.05,0.24 0.24,0.41 0.48,0.41h3.84c0.24,0 0.44,-0.17 0.47,-0.41l0.36,-2.54c0.59,-0.24 1.13,-0.56 1.62,-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59,-0.22l1.92,-3.32c0.12,-0.22 0.07,-0.47 -0.12,-0.61l-2.01,-1.58z M12,15.6c-1.98,0 -3.6,-1.62 -3.6,-3.6s1.62,-3.6 3.6,-3.6 3.6,1.62 3.6,3.6 -1.62,3.6 -3.6,3.6z</StreamGeometry>
        <StreamGeometry x:Key="IconKeypad">M12,19c-1.1,0 -2,0.9 -2,2s0.9,2 2,2 2,-0.9 2,-2 -0.9,-2 -2,-2z M6,1c-1.1,0 -2,0.9 -2,2s0.9,2 2,2 2,-0.9 2,-2 -0.9,-2 -2,-2z M6,7c-1.1,0 -2,0.9 -2,2s0.9,2 2,2 2,-0.9 2,-2 -0.9,-2 -2,-2z M6,13c-1.1,0 -2,0.9 -2,2s0.9,2 2,2 2,-0.9 2,-2 -0.9,-2 -2,-2z M18,5c1.1,0 2,-0.9 2,-2s-0.9,-2 -2,-2 -2,0.9 -2,2 0.9,2 2,2z M12,7c-1.1,0 -2,0.9 -2,2s0.9,2 2,2 2,-0.9 2,-2 -0.9,-2 -2,-2z M12,13c-1.1,0 -2,0.9 -2,2s0.9,2 2,2 2,-0.9 2,-2 -0.9,-2 -2,-2z M18,11c1.1,0 2,-0.9 2,-2s-0.9,-2 -2,-2 -2,0.9 -2,2 0.9,2 2,2z M18,17c1.1,0 2,-0.9 2,-2s-0.9,-2 -2,-2 -2,0.9 -2,2 0.9,2 2,2z</StreamGeometry>
        <StreamGeometry x:Key="IconWifi">M12,4C7.31,4 3.07,5.9 0,8.98L12,21 24,8.98C20.93,5.9 16.69,4 12,4z M12,8c3.27,0 6.27,1.24 8.54,3.29L12,19.83 3.46,11.29C5.73,9.24 8.73,8 12,8z</StreamGeometry>
        <StreamGeometry x:Key="IconFastboot">M15,7v4h1v2h-3V5h2l-3,-4 -3,4h2v8H8v-2h1V7H6v4h1v3c0,1.1 0.9,2 2,2h2v3c-0.55,0.28 -1,0.85 -1,1.5 0,0.96 0.84,1.75 1.83,1.75s1.83,-0.79 1.83,-1.75c0,-0.65 -0.45,-1.22 -1,-1.5v-3h2c1.1,0 2,-0.9 2,-2v-3h1v-4h-2z</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Estilo das Abas Superiores Oficiais -->
        <Style Selector="Button.TopTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9FAEBF" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Height" Value="60" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- ====================================================================
             Estados interativos com CONTRASTE GARANTIDO (hover/pressed).
             O FluentTheme pinta o /template/ ContentPresenter nesses estados com
             brushes claros — sobre nossos cards claros o texto branco sumia.
             Os overrides abaixo forçam fundo + borda de alto contraste em TODOS
             os botões custom, mantendo o texto sempre legível.
             ==================================================================== -->

        <!-- Abas superiores -->
        <Style Selector="Button.TopTab:pointerover">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.TopTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0A223B" />
            <Setter Property="BorderBrush" Value="#0A223B" />
        </Style>
        <Style Selector="Button.TopTab:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0F2A45" />
        </Style>
        <Style Selector="Button.TopTab.Active">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.TopTab.Active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ActiveTabTealBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ActiveTabTealBrush}" />
        </Style>
        <Style Selector="Button.TopTab.Active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#00719B" />
            <Setter Property="BorderBrush" Value="#00719B" />
        </Style>

        <!-- Botão de Ação Pill Oficial (Teal #005D7F) -->
        <Style Selector="Button.ActionPill">
            <Setter Property="Background" Value="{StaticResource ActionPillTealBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="28,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ActionPill:pointerover">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.ActionPill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#007DA6" />
            <Setter Property="BorderBrush" Value="#007DA6" />
        </Style>
        <Style Selector="Button.ActionPill:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#004E6B" />
        </Style>

        <!-- Botão Secundário / Voltar / Feedback / "Testar" -->
        <Style Selector="Button.SecondaryPill">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#6D86AB" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderBrush" Value="#2A3D52" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.SecondaryPill:pointerover">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.SecondaryPill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#132B45" />
            <Setter Property="BorderBrush" Value="#3E5871" />
        </Style>
        <Style Selector="Button.SecondaryPill:pressed">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.SecondaryPill:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0C1B2E" />
            <Setter Property="BorderBrush" Value="#0C1B2E" />
        </Style>

        <!-- Cards Interativos da Tela Welcome -->
        <Style Selector="Button.WelcomeOptionCard">
            <Setter Property="Background" Value="{StaticResource WelcomeCardBgBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="#183654" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.WelcomeOptionCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource WelcomeCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="#005D7F" />
        </Style>
        <Style Selector="Button.WelcomeOptionCard:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0A1E33" />
            <Setter Property="BorderBrush" Value="#005D7F" />
        </Style>
    </Application.Styles>
</Application>
