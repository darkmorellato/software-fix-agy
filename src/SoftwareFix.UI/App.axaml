    <Application.Styles>
        <FluentTheme />

        <!-- Abas Superiores (arte oficial v7.4): ícone em cima, rótulo embaixo,
             aba ativa com bloco azul cheio e cantos superiores arredondados -->
        <Style Selector="Button.TopTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C9D6E4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Height" Value="72" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- ====================================================================
             Estados interativos com CONTRASTE GARANTIDO (hover/pressed).
             O FluentTheme pinta o /template/ ContentPresenter nesses estados com
             brushes claros — sobre nossos cards claros o texto branco sumia.
             Os overrides abaixo forçam fundo + borda de alto contraste em TODOS
             os botões custom, mantendo o texto sempre legível.
             ==================================================================== -->

        <!-- Abas superiores -->
        <Style Selector="Button.TopTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0E2A44" />
            <Setter Property="BorderBrush" Value="#0E2A44" />
        </Style>
        <Style Selector="Button.TopTab:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#123553" />
        </Style>
        <Style Selector="Button.TopTab.Active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource TopTabActiveBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TopTabActiveBrush}" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
        </Style>
        <Style Selector="Button.TopTab.Active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1B84BB" />
            <Setter Property="BorderBrush" Value="#1B84BB" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
        </Style>

        <!-- Abas internas claras (sub-navegação das seções, ex.: Backup | Restauração) -->
        <Style Selector="Button.SubTab">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="22,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.SubTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
        </Style>
        <Style Selector="Button.SubTab.Active">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.SubTab.Active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource TopTabActiveBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TopTabActiveBrush}" />
        </Style>
        <Style Selector="Button.SubTab.Active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1B84BB" />
            <Setter Property="BorderBrush" Value="#1B84BB" />
        </Style>

        <!-- Tela "Selecione o Tipo de Dispositivo" (arte oficial, primeiro passo do Resgate) -->
        <Style Selector="Button.DeviceTypeCard">
            <Setter Property="Background" Value="#0C2540" />
            <Setter Property="BorderBrush" Value="#1E4270" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="26,22" />
            <Setter Property="Width" Value="208" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransform" Value="scale(1.0)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.DeviceTypeCard:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.025)" />
        </Style>
        <Style Selector="Button.DeviceTypeCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#123055" />
            <Setter Property="BorderBrush" Value="#2E6E9E" />
        </Style>
        <Style Selector="Button.DeviceTypeCard:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0A2340" />
        </Style>

        <!-- ✨ Transições suaves de hover em TODOS os botões (polimento artístico) -->
        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>

        <!-- ✨ Badge "Recomendado": pulso suave e vivo -->
        <Style Selector="Border.BadgePulse">
            <Style.Animations>
                <Animation Duration="0:0:2.2" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.72" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Botão de Ação Pill Oficial (Teal #005D7F) -->
        <Style Selector="Button.ActionPill">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#0B7199" Offset="0" />
                    <GradientStop Color="#00536F" Offset="1" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="28,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ActionPill:pointerover">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.ActionPill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#007DA6" />
            <Setter Property="BorderBrush" Value="#007DA6" />
        </Style>
        <Style Selector="Button.ActionPill:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#004E6B" />
        </Style>

        <!-- Tela inicial de login (réplica do app oficial): botão grande azul, pill de
             Feedback, fechar e links-texto -->
        <Style Selector="Button.BigLogin">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#1290C4" Offset="0" />
                    <GradientStop Color="#0B6390" Offset="1" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.BigLogin:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1390CD" />
        </Style>
        <Style Selector="Button.BigLogin:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0B6390" />
        </Style>
        <Style Selector="Button.FeedbackPill">
            <Setter Property="Background" Value="#3A74AC" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.WindowClose">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.LinkLike">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#55ACDF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Botão Secundário / Voltar / Feedback / "Testar" -->
        <Style Selector="Button.SecondaryPill">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#6D86AB" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderBrush" Value="#2A3D52" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.SecondaryPill:pointerover">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.SecondaryPill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#132B45" />
            <Setter Property="BorderBrush" Value="#3E5871" />
        </Style>
        <Style Selector="Button.SecondaryPill:pressed">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.SecondaryPill:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0C1B2E" />
            <Setter Property="BorderBrush" Value="#0C1B2E" />
        </Style>

        <!-- Cards Interativos da Tela Welcome -->
        <Style Selector="Button.WelcomeOptionCard">
            <Setter Property="Background" Value="{StaticResource WelcomeCardBgBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="#183654" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransform" Value="scale(1.0)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.WelcomeOptionCard:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.015)" />
        </Style>
        <Style Selector="Button.WelcomeOptionCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource WelcomeCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="#005D7F" />
        </Style>
        <Style Selector="Button.WelcomeOptionCard:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0A1E33" />
            <Setter Property="BorderBrush" Value="#005D7F" />
        </Style>

        <!-- ====================================================================
             Tabela de Hardware Test — zebra striping oficial
             ==================================================================== -->
        <Style Selector="Border.DiagRow">
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style Selector="Border.DiagRow.Alt">
            <Setter Property="Background" Value="#F5F8FB" />
        </Style>

        <!-- ====================================================================
             Sidebar de Categorias (My Device) — item ativo em pill teal
             ==================================================================== -->
        <Style Selector="Button.SideItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.SideItem PathIcon">
            <Setter Property="Foreground" Value="#6D86AB" />
        </Style>
        <Style Selector="Button.SideItem:pointerover">
            <Setter Property="Foreground" Value="#005D7F" />
        </Style>
        <Style Selector="Button.SideItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#EAF2F8" />
            <Setter Property="BorderBrush" Value="#EAF2F8" />
        </Style>
        <Style Selector="Button.SideItem.Active">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.SideItem.Active PathIcon">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.SideItem.Active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ActiveTabTealBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ActiveTabTealBrush}" />
        </Style>
        <Style Selector="Button.SideItem.Active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#00719B" />
            <Setter Property="BorderBrush" Value="#00719B" />
        </Style>
    </Application.Styles>
</Application>
