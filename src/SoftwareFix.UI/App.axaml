<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SoftwareFix.UI.App"
             xmlns:local="using:SoftwareFix.UI"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Cores Oficiais Motorola / Software Fix -->
        <Color x:Key="MotoBlueColor">#0072CE</Color>
        <Color x:Key="MotoCyanColor">#00A3FF</Color>
        <Color x:Key="MotoNavyColor">#0A192F</Color>
        <Color x:Key="BgDarkColor">#0F1115</Color>
        <Color x:Key="SidebarBgColor">#15181E</Color>
        <Color x:Key="CardBgColor">#1C1F27</Color>
        <Color x:Key="CardElevatedBgColor">#242833</Color>
        <Color x:Key="BorderDarkColor">#2A303D</Color>
        <Color x:Key="SuccessGreenColor">#10B981</Color>
        <Color x:Key="WarningAmberColor">#F59E0B</Color>
        <Color x:Key="DangerRedColor">#EF4444</Color>

        <!-- Pincéis (Brushes) -->
        <SolidColorBrush x:Key="MotoBlueBrush" Color="{StaticResource MotoBlueColor}" />
        <SolidColorBrush x:Key="MotoCyanBrush" Color="{StaticResource MotoCyanColor}" />
        <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}" />
        <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}" />
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
        <SolidColorBrush x:Key="CardElevatedBgBrush" Color="{StaticResource CardElevatedBgColor}" />
        <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDarkColor}" />
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreenColor}" />
        <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmberColor}" />
        <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRedColor}" />
        <SolidColorBrush x:Key="TextWhiteBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#8E95A5" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1" />

        <!-- Gradientes -->
        <LinearGradientBrush x:Key="MotoPrimaryGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#0062B8" />
            <GradientStop Offset="1" Color="#00A3FF" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RescueButtonGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#E11D48" />
            <GradientStop Offset="1" Color="#F43F5E" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardHeaderGradient" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0" Color="#182338" />
            <GradientStop Offset="1" Color="#1C1F27" />
        </LinearGradientBrush>

        <!-- Ícones Vetoriais SVG (StreamGeometry) -->
        <StreamGeometry x:Key="IconPhone">M17,1.01L7,1C5.9,1 5,1.9 5,3v18c0,1.1 0.9,2 2,2h10c1.1,0 2,-0.9 2,-2V3C19,1.9 18.1,1.01 17,1.01z M17,19H7V5h10V19z</StreamGeometry>
        <StreamGeometry x:Key="IconShieldRescue">M12,1L3,5v6c0,5.55 3.84,10.74 9,12c5.16,-1.26 9,-6.45 9,-12V5L12,1z M12,11.99h7c-0.53,4.12 -3.28,7.79 -7,8.94V12H5V6.3l7,-3.11V11.99z</StreamGeometry>
